	chapter.0F90E449932A8DFA.title: "Пробуждение Архива"
	chapter.018D9A7CF692B9F5.chapter_subtitle: ["Уютная база, еда и первые удобства"]
	chapter.018D9A7CF692B9F5.title: "Дом на обломках неба"
