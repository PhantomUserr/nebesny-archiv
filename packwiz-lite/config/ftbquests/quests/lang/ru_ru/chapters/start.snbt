{
	"quest.893D1BB287C831F7.quest_desc": ["Ты очнулся среди обломков огромной летающей библиотеки. Корабли Архива разбились, страницы разлетелись по миру, а знания теперь придётся собирать заново.", "Этот квест — твоя карта. Жми кнопку «Завершить», читай подсказки и не бойся ошибаться: здесь нет неправильного пути.", "Совет: нажми {key.key.jei.show_recipes} на предмете в инвентаре, чтобы увидеть, как его сделать."]
	"quest.893D1BB287C831F7.title": "Добро пожаловать в Архив"
	"quest.A00766F1A4D085BF.quest_desc": ["????? 8 ?????? ? ??????. ??????? ? ?????? ? ????? ????? ?????? ????, ???? ???? ?? ?????????? ? ?????? ??????? ?? ?????, ??????? ??.", "?? ?????? ????????? ??? ?????????: ?????, ?????, ??????? ? ?????? ???????????."]
	"quest.A00766F1A4D085BF.title": "?????? ??????"
	"quest.B5551A337CA1F70C.quest_desc": ["Поставь верстак и открой его правой кнопкой. В сетке 3×3 можно собрать почти любой предмет.", "Верхний ряд: доски. Нижний ряд: доски. В центре — палки. Так получаются инструменты."]
	"quest.B5551A337CA1F70C.title": "Верстак"
	"quest.1EE2CD3A62F77B5D.quest_desc": ["Две палки и три доски — и у тебя есть кирка. Ей можно добывать камень.", "Не забудь прочность: если инструмент сломается, просто сделай новый."]
	"quest.1EE2CD3A62F77B5D.title": "Деревянная кирка"
	"quest.3C2335E032BA5D48.quest_desc": ["Найди серый камень и добудь его киркой. Собери хотя бы 24 штуки — хватит на печь и инструменты."]
	"quest.3C2335E032BA5D48.title": "Камень под ногами"
	"quest.DF0C55FE90F3251B.quest_desc": ["???????? ????? ??????? ?????????? ? ?????, ????? ???????? ???????? ????. ?????? ????? ? ???????? ??? ? ??? ?????????? ??? ??????? ? ?????????.", "????? ????? ????? ??????, ???????? ??????: ?????? ????????? ???? ??????? ??? ????."]
	"quest.DF0C55FE90F3251B.title": "???????? ???????????"
	"quest.B1AA45DE289E7995.quest_desc": ["Уголь можно найти в жилах под землёй или получить из обожжённого дерева. Сделай факелы — они не дадут мобам спавниться рядом.", "Факелы ставятся на стены и пол. Свет — первая защита новичка."]
	"quest.B1AA45DE289E7995.title": "Свет и уголь"
	"quest.872951914D631C14.quest_desc": ["Печь плавит руду, готовит еду и обжигает глину. Поставь её рядом с верстаком.", "Топливо: уголь, древесный уголь или доски."]
	"quest.872951914D631C14.title": "Печь"
	"quest.14D6F45E906DC009.quest_desc": ["Голод мешает бегать и лечиться. Сделай хлеб из пшеницы или приготовь мясо в печи.", "Держи в сумке хотя бы 3 единицы еды перед вылазкой."]
	"quest.14D6F45E906DC009.title": "Сытый герой"
	"quest.573660879FF5508C.quest_desc": ["Кровать задаёт точку возрождения и пропускает ночь. Без неё смерть отправит тебя далеко назад.", "Спать можно только ночью и только если рядом нет монстров."]
	"quest.573660879FF5508C.title": "Своя кровать"
	"quest.EABB993094E59A0A.quest_desc": ["Найди железную руду, добудь её каменной киркой и переплавь в печи.", "Железо — ключ к ведрам, щитам, ножницам и нормальной броне."]
	"quest.EABB993094E59A0A.title": "Железо"
	"quest.0335C6DFB87DD741.quest_desc": ["Железная кирка добывает золото, алмазы и красный камень. Сделай её, как только наберётся 3 слитка.", "С этого момента начинается настоящая игра."]
	"quest.0335C6DFB87DD741.title": "Железная кирка"
	"quest.325A4660FA1790E9.quest_desc": ["Рюкзак сильно упрощает жизнь: в нём хранятся инструменты, еда и добыча.", "Скрафти рюкзак и надень его. Открывается клавишей, указанной в настройках управления."]
	"quest.325A4660FA1790E9.title": "Рюкзак"
	"quest.B96DA29463C25AE1.quest_desc": ["В верхнем левом углу появляются советы по моду. Это не случайные фразы — они подсказывают следующий шаг.", "Если совет пропал, подожди: Tips показывает новый каждые несколько секунд."]
	"quest.B96DA29463C25AE1.title": "Подсказки на экране"
	"quest.DB077EC7508712D8.quest_desc": ["Ты очнулся — и первые страницы Архива разлетелись по миру. Пока корабли в небесах, а библиотека в обломках, главное знание должно быть у тебя.", "Сделай записную книгу: книга и чернильный мешочек скрафтятся в written book через подписывание, но для квеста достаточно получить саму книгу с записями любым доступным способом."]
	"quest.DB077EC7508712D8.title": "Записная книга"
}
