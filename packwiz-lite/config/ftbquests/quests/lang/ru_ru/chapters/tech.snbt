{
	"quest.0FC122D05AFA785A.quest_desc": ["Осмий — базовый металл Mekanism. Ищи серую руду под землёй.", "Собери 8 единиц сырья."]
	"quest.0FC122D05AFA785A.title": "Осмий"
	"quest.073D233AEF2CADBC.quest_desc": ["Инфузер сплавляет металлы и создаёт сплавы. Поставь его и подключи энергию."]
	"quest.073D233AEF2CADBC.title": "Металлургический инфузер"
	"quest.0A9323B5494772BD.quest_desc": ["Обогатитель превращает руду в пыль и удваивает добычу. Очень полезная машина на старте."]
	"quest.0A9323B5494772BD.title": "Обогатитель"
	"quest.01989A18675CD797.quest_desc": ["Сталь делается в инфузере из железа и угля. Она нужна для машин, брони и реакторов."]
	"quest.01989A18675CD797.title": "Сталь"
	"quest.0DB8070E390B55C0.quest_desc": ["Теплогенератор даёт первую энергию. Поставь его рядом с лавой или горячим блоком.", "Энергия передаётся по кабелям."]
	"quest.0DB8070E390B55C0.title": "Теплогенератор"
	"quest.07FBEFC61491F7EB.quest_desc": ["Кабель соединяет генератор и машины. Сделай 8 штук и протяни линию."]
	"quest.07FBEFC61491F7EB.title": "Универсальный кабель"
	"quest.067C4E43AA5D9CB0.quest_desc": ["Энергокуб хранит энергию. Поставь его между генератором и машинами, чтобы не простаивать."]
	"quest.067C4E43AA5D9CB0.title": "Энергохранилище"
	"quest.0962BD5CC61EEE27.quest_desc": ["Цифровой шахтёр сам добывает руду в заданном регионе. Поставь его на рудное месторождение и подключи энергию.", "Это огромный шаг вперёд по ресурсам."]
	"quest.0962BD5CC61EEE27.title": "Цифровой шахтёр"
	"quest.0B055B1D760A7756.quest_desc": ["AE2 начинается с кварца Сертус. Найди жилы в пещерах и добудь 8 кристаллов."]
	"quest.0B055B1D760A7756.title": "Кварц Сертус"
	"quest.010BA185F8184CF6.quest_desc": ["Зарядник превращает обычный кварц в заряженный. Заряженный кварц нужен для продвинутых деталей."]
	"quest.010BA185F8184CF6.title": "Зарядник"
	"quest.0DA8DB7C5E01AF78.quest_desc": ["Гравировальщик делает печатные платы и процессоры. Поставь его и подай энергию."]
	"quest.0DA8DB7C5E01AF78.title": "Гравировальщик"
	"quest.03C61831DA862E0F.quest_desc": ["Контроллер — сердце сети. Он распределяет энергию и каналы между устройствами.", "Поставь его в центре будущей системы."]
	"quest.03C61831DA862E0F.title": "Контроллер ME"
	"quest.04641092348515D7.quest_desc": ["Дисковод хранит ячейки с предметами. Вставь ячейку — и сеть увидит её содержимое."]
	"quest.04641092348515D7.title": "Дисковод"
	"quest.001AAF097BECC060.quest_desc": ["Терминал — это интерфейс сети. Через него ты кладёшь и берёшь предметы.", "Поставь его рядом с дисководом."]
	"quest.001AAF097BECC060.title": "Терминал"
	"quest.0ECFD241102E72B6.quest_desc": ["Приёмник энергии подключает сеть AE2 к внешнему источнику. Без него контроллер не запустится."]
	"quest.0ECFD241102E72B6.title": "Приёмник энергии"
	"quest.0BE8B76E1AF1ADC3.quest_desc": ["Шаблон описывает рецепт для автосборки. Сделай 8 пустых шаблонов и закодируй их в терминале."]
	"quest.0BE8B76E1AF1ADC3.title": "Шаблоны"
	"quest.0D9D02AE010E528A.quest_desc": ["Сборщик выполняет рецепты из шаблонов. Поставь его рядом с шаблонным провайдером."]
	"quest.0D9D02AE010E528A.title": "Молекулярный сборщик"
	"quest.09BDAEC055CF53B0.quest_desc": ["Настрой шаблон, подключи сборщик и запусти крафт через терминал. С этого момента сеть собирает предметы сама."]
	"quest.09BDAEC055CF53B0.title": "Автокрафт"
	"quest.0EE0A2386B696725.quest_desc": ["Беспроводной терминал даёт доступ к сети издалека. Подключи его к сети и наслаждайся."]
	"quest.0EE0A2386B696725.title": "Беспроводной терминал"
	"quest.0B8A3FF0721742D9.quest_desc": ["Квантовые кольца соединяют две сети на любом расстоянии. Это высший уровень AE2.", "Построй две связанные сети и почувствуй себя архимагом логистики."]
	"quest.0B8A3FF0721742D9.title": "Квантовая сеть"
	"quest.0428E7A5252289B4.quest_desc": ["Мелких генераторов хватает для лампочек и печей, но не для фабрик. Элитное энергохранилище — сердце больших механизмов.", "Оно подержит энергию для станков, крафтеров и автокрафта, когда нагрузка вырастет."]
	"quest.0428E7A5252289B4.title": "Реакторный запас"
}
