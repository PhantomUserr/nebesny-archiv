{
	"quest.0CEAAEB682A68CE1.quest_desc": ["Бур достаёт руду из жилы, не выкапывая всю гору. Обычный бур дешёвый, алмазный — быстрее, незеритовый — почти вечный.", "Сделай обычный бур и алмазный: на первое время хватит за глаза."]
	"quest.0CEAAEB682A68CE1.title": "Буровой инструмент"
	"quest.0C5432137F6A9BBE.quest_desc": ["Буровая машина ставится на жилу и работает сама: вращение даёт ей кинетический вход, а добыча выходит через блок ввода-вывода.", "Собери буровую машину, кинетический вход и блок ввода-вывода."]
	"quest.0C5432137F6A9BBE.title": "Буровая машина"
	"quest.0EEEDC00D0C6FCE3.quest_desc": ["Экстрактор вытягивает из жилы то, что в ней есть, но медленно и без бура. Иногда это единственный выход, если жила не поддаётся.", "Собери экстрактор и мультиблок для крупной добычи."]
	"quest.0EEEDC00D0C6FCE3.title": "Экстрактор"
	"quest.02F5A7B1416954C0.quest_desc": ["Искатель жил показывает, где под землёй лежит руда. Атлас жил хранит всё, что ты уже нашёл.", "Сделай искатель жил и атлас жил — без них бурить нечего."]
	"quest.02F5A7B1416954C0.title": "Искатель жил"
	"quest.0A40859731D0756B.quest_desc": ["Пробоотборник берёт образец из жилы и показывает, что в ней есть: алмазы, изумруды, редстоун.", "Собери пробоотборник и проверь первую жилу."]
	"quest.0A40859731D0756B.title": "Проба породы"
	"quest.07F6BAB475834176.quest_desc": ["Незеритовый бур не тупится и проходит породу, на которой обычный бур встаёт.", "Сделай незеритовый бур и алмазную руду добудь уже им."]
	"quest.07F6BAB475834176.title": "Незеритовый бур"
	"quest.0492F36DB4C7BA2C.quest_desc": ["Тулган притягивает и ставит блоки на расстоянии. Им собирают корпус корабля, не слезая с палубы.", "Собери магнитную пушку — она пригодится и в мастерской, и на верфи."]
	"quest.0492F36DB4C7BA2C.title": "Магнитная пушка"
	"quest.0C2307504940A2B3.quest_desc": ["Структурный инструмент сохраняет постройку и ставит её заново одним щелчком. Так переносят целые ангары.", "Собери структурный инструмент и его выживальческий вариант."]
	"quest.0C2307504940A2B3.title": "Инструмент структур"
	"quest.0B9AC01CBC16BD25.quest_desc": ["Принтер ставит сохранённую структуру из контейнера. С ним корабль можно пересобрать после аварии.", "Собери портативный принтер структур и контейнер для него."]
	"quest.0B9AC01CBC16BD25.title": "Принтер структур"
	"quest.0AD91FF7A00B5773.quest_desc": ["Обычная труба на летающем корабле течёт во все стороны. Труба в обёртке силового поля держит жидкость внутри.", "Собери трубы в белой и чёрной обёртке — остальные цвета потом."]
	"quest.0AD91FF7A00B5773.title": "Трубы в обёртке"
	"quest.00336AB464C3ACB6.quest_desc": ["Гидравлический стержень выдвигается и толкает. Регулятор задаёт силу, головка крепит его к детали.", "Собери гидравлический стержень, регулятор и соединительную головку."]
	"quest.00336AB464C3ACB6.title": "Гидравлика"
	"quest.02B8C33CC66FFA4B.quest_desc": ["Универсальный шарнир передаёт вращение под любым углом. Без него вал на корабле не согнуть.", "Собери универсальный шарнир, его стержень и латунный вариант."]
	"quest.02B8C33CC66FFA4B.title": "Шарниры"
	"quest.08197276447AAE08.quest_desc": ["Демпферный подшипник гасит тряску, гигантский стержень держит крупные узлы, а латунная головка выдерживает нагрузку.", "Собери демпферный подшипник, гигантский гидравлический стержень и латунную головку шарнира."]
	"quest.08197276447AAE08.title": "Демпферы"
	"quest.0B3FB77DC74E23E6.quest_desc": ["Малый двигатель, RCS-двигатель и обычный двигатель дают разную тягу. На орбите точность важнее силы.", "Собери обычный, малый и RCS-двигатель."]
	"quest.0B3FB77DC74E23E6.title": "Малые двигатели"
	"quest.0CAA32FA4E95E763.quest_desc": ["Навигационный стол прокладывает маршрут, продвинутый — ещё и учитывает ветер. Модуль управления ставится на корабль.", "Собери навигационный стол, продвинутый стол и модуль управления кораблём."]
	"quest.0CAA32FA4E95E763.title": "Навигационный стол"
	"quest.0E0A6A8764BF7FD4.quest_desc": ["Док держит корабль на месте, сцепка соединяет два корабля в один, а манифест описывает груз.", "Собери док, сцепку и грузовой манифест."]
	"quest.0E0A6A8764BF7FD4.title": "Док и сцепка"
	"quest.0DD68587BD20255B.quest_desc": ["Умный бак хранит жидкость, умное хранилище — предметы, умная батарея — энергию. Все три показывают запас снаружи.", "Собери умный бак, умный сейф и умную батарею."]
	"quest.0DD68587BD20255B.title": "Умные ёмкости"
	"quest.0BF4BE656CE8245E.quest_desc": ["Паттерн-рестокер сам возвращает шаблоны в провайдеры. Сеть перестаёт вставать из-за пустых шаблонов.", "Поставь паттерн-рестокер рядом с провайдером шаблонов и проверь автокрафт."]
	"quest.0BF4BE656CE8245E.title": "Пополнение шаблонов"
}
