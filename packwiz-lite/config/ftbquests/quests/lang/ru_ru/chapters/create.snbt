{
	"quest.06FA27F1C93D4F60.quest_desc": ["Create начинается с андезитового сплава. Смешай андезит и железный самородок — точный рецепт смотри в JEI.", "Сделай хотя бы 8 сплавов."]
	"quest.06FA27F1C93D4F60.title": "Андезитовый сплав"
	"quest.0114972F7C4A9A38.quest_desc": ["Вал передаёт вращение. Поставь его между колесом и механизмом.", "Валы можно соединять, поворачивать и закрывать корпусами."]
	"quest.0114972F7C4A9A38.title": "Валы"
	"quest.039A844570D771B9.quest_desc": ["Шестерни меняют направление и скорость вращения. Большая шестерня замедляет, маленькая ускоряет.", "Сделай несколько маленьких и одну большую."]
	"quest.039A844570D771B9.title": "Шестерни"
	"quest.0D55895B2FC79188.quest_desc": ["Водяное колесо — самый простой источник энергии. Поставь его в поток воды так, чтобы вода толкала лопасти.", "Подключи вал — и вращение пошло."]
	"quest.0D55895B2FC79188.title": "Водяное колесо"
	"quest.013F16CC570578CE.quest_desc": ["Ветряное колесо даёт больше энергии, но требует парусов и открытого неба.", "Поставь подшипник, прикрепи паруса и наслаждайся бесплатным вращением."]
	"quest.013F16CC570578CE.title": "Ветряк"
	"quest.030DCB97554A6D90.quest_desc": ["Пресс сжимает предметы: листы, блоки, детали. Поставь его над депо или лентой.", "Ему нужно вращение сверху."]
	"quest.030DCB97554A6D90.title": "Механический пресс"
	"quest.087901D704306B8A.quest_desc": ["Миксер смешивает ингредиенты в чаше. Без него не сделать латунь и многие сплавы.", "Поставь чашу под миксер и подай вращение."]
	"quest.087901D704306B8A.title": "Механический миксер"
	"quest.036202AD95D4358A.quest_desc": ["Пила распиливает брёвна и предметы без потерь. Отличный способ автоматизировать доски."]
	"quest.036202AD95D4358A.title": "Механическая пила"
	"quest.049A4E379B29762B.quest_desc": ["Вентилятор обдувает предметы и мобов. С лавой он плавит, с водой — тушит, с огнём — готовит.", "Поставь его в корпус и подай вращение."]
	"quest.049A4E379B29762B.title": "Вентилятор"
	"quest.04F8F7FC0D168165.quest_desc": ["Жернов дробит руду и зёрна. Поставь его под вал и засыпай предметы сверху."]
	"quest.04F8F7FC0D168165.title": "Жернов"
	"quest.0CC984BDA2B468B2.quest_desc": ["Чаша нужна для смешивания, варки и прессования жидкостей. Ставь её под миксер или пресс."]
	"quest.0CC984BDA2B468B2.title": "Чаша"
	"quest.00756073B85A651E.quest_desc": ["Лента двигает предметы между машинами. Соедини две точки и подай вращение.", "Сделай 4 секции ленты."]
	"quest.00756073B85A651E.title": "Конвейер"
	"quest.0FAB380031A0D63C.quest_desc": ["Воронки забирают и выдают предметы. Андезитовая — базовая, латунная — быстрее и умнее.", "Сделай обе: они понадобятся для автоматизации."]
	"quest.0FAB380031A0D63C.title": "Воронки"
	"quest.0A1AF8F5EE5C6D01.quest_desc": ["Латунь — сплав меди и цинка. Плавь её в чаше миксером или в плавильне.", "Латунные детали открывают продвинутые механизмы."]
	"quest.0A1AF8F5EE5C6D01.title": "Латунь"
	"quest.05E6EE1C4F903244.quest_desc": ["Точный механизм — сердце сложных машин. Собери хотя бы один: он понадобится для поездов и аэронавтики."]
	"quest.05E6EE1C4F903244.title": "Точный механизм"
	"quest.0E0AC64A219AAD4F.quest_desc": ["Регулятор меняет скорость вращения. Пригодится, когда механизмы работают слишком быстро или медленно."]
	"quest.0E0AC64A219AAD4F.title": "Регулятор скорости"
	"quest.0CFA9D7191048FDF.quest_desc": ["Крафтер собирает предметы по рецепту автоматически. Поставь его рядом с лентой и настрой рецепт."]
	"quest.0CFA9D7191048FDF.title": "Механический крафтер"
	"quest.064BCFFC7C87D838.quest_desc": ["Create добавляет настоящие рельсы для поездов. Сделай 32 секции и проложи путь.", "Рельсы ставятся на землю и соединяются автоматически."]
	"quest.064BCFFC7C87D838.title": "Рельсы"
	"quest.0AA406E4BFDC87B1.quest_desc": ["Станция собирает поезд и останавливает его. Поставь её в конце пути."]
	"quest.0AA406E4BFDC87B1.title": "Станция"
	"quest.08EE69FEEB63C9A0.quest_desc": ["Собери поезд из локомотива и вагонов, поставь его на рельсы и прокатись. Это проще, чем кажется: собери состав, сядь и нажми газ."]
	"quest.08EE69FEEB63C9A0.title": "Первая поездка"
	"quest.0B990E6BC796B849.quest_desc": ["Колесо качает воду, но без насоса она всё равно течёт мимо. Поставь механический насос рядом с водяным колесом — и фермы получат воду по трубам.", "Подключи насос валом к источнику вращения и направь трубы туда, где нужна вода."]
	"quest.0B990E6BC796B849.title": "Механический насос"
}
