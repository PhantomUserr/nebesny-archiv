{
	"quest.0477295F5E9A1E24.quest_desc": ["Собери незеритовый слиток: древние обломки плавятся в печи и соединяются с золотом.", "Незерит — лучший ванильный материал."]
	"quest.0477295F5E9A1E24.title": "Незерит"
	"quest.04D294D08ED6BBDB.quest_desc": ["Маяк даёт мощные эффекты всем рядом. Поставь его на пирамиду из железа или незерита."]
	"quest.04D294D08ED6BBDB.title": "Маяк"
	"quest.0F04E328B38E5762.quest_desc": ["Звезда выпадает с Иссушителя. Она нужна для маяка и многих сильных рецептов."]
	"quest.0F04E328B38E5762.title": "Звезда Нижнего мира"
	"quest.00151C0A5EE49F38.quest_desc": ["Элитры позволяют летать. Найди корабль Края и забери крылья."]
	"quest.00151C0A5EE49F38.title": "Элитры"
	"quest.0865A7AD21F4A758.quest_desc": ["Построй музей: витрины с редкими предметами, трофеями боссов и магическими артефактами.", "Это место силы твоей базы и памяти о приключениях."]
	"quest.0865A7AD21F4A758.title": "Музей Архива"
	"quest.03A4E2E4089BB241.quest_desc": ["Собери хотя бы три летающих корабля: грузовой, боевой и исследовательский.", "Архив снова должен подняться в небо."]
	"quest.03A4E2E4089BB241.title": "Флот в небе"
	"quest.0F5778D9C11F0514.quest_desc": ["Соедини технологии и магию: автоматизируй алтари, подключи магические машины к AE2, поставь на корабль магический реактор.", "Это необязательный мост между ветками, но именно он делает базу легендарной."]
	"quest.0F5778D9C11F0514.title": "Техномагия"
	"quest.0FA4E757F2B83F19.quest_desc": ["Собери 32 книжные полки и заполни ими библиотеку. Знания Архива должны быть в порядке.", "Можно использовать модовые полки — главное, чтобы книг было много."]
	"quest.0FA4E757F2B83F19.title": "Хранилище знаний"
	"quest.0A8AAD3B279D0BF3.quest_desc": ["Накопи 4 блока алмазов. Это не обязательно для финала, но приятно."]
	"quest.0A8AAD3B279D0BF3.title": "Настоящий архимаг"
	"quest.0B6526CB678FDB28.quest_desc": ["Победи всех сюжетных боссов: Нижнего монстра, Стража Края, Визиря и Цветок пустоты.", "Трофеи можно расставить в музее."]
	"quest.0B6526CB678FDB28.title": "Коллекционер трофеев"
	"quest.0E8D59F1B93F31AF.quest_desc": ["Ты собрал знания, поднял флот и собрал команду. Архив снова в небе — теперь твоя очередь хранить его историю.", "Спасибо за игру. Дальше — только твои собственные цели: мегабазы, города, войны и новые миры."]
	"quest.0E8D59F1B93F31AF.title": "Архив снова в небе"
	"quest.060559198D438412.quest_desc": ["Библиотека собрана: полки, книги, трофеи. Осталось запечатать память Архива.", "Собери три книги знаний — они станут символом восстановленных страниц и завершат коллекцию музея."]
	"quest.060559198D438412.title": "Артефакт Архива"
}
