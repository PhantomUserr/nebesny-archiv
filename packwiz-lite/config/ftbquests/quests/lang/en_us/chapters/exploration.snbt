{
	"quest.096678F3071D4453.quest_desc": ["Варп-камень телепортирует к активированному камню возврата из любой точки.", "Сделай его и держи в инвентаре — это твой личный телепорт."]
	"quest.096678F3071D4453.title": "Варп-камень"
	"quest.07943C546267E731.quest_desc": ["Nature’s Compass ищет биомы. Нажми правой кнопкой и выбери нужный — компас укажет направление.", "Незаменим для поиска Эфира, грибных островов и редких биомов."]
	"quest.07943C546267E731.title": "Компас природы"
	"quest.0236FB373FE35468.quest_desc": ["Построй портал из обсидиана 4×5 и зажги его огнивом. Нижний мир полон опасностей и ресурсов.", "Возьми с собой еду, броню и запасные блоки."]
	"quest.0236FB373FE35468.title": "Нижний мир"
	"quest.0C76BF012DD5C5B2.quest_desc": ["Стержни лавовых духов нужны для варки зелий и глаза Эндера.", "Найди крепость в Нижнем мире и собери 6 стержней."]
	"quest.0C76BF012DD5C5B2.title": "Огненные стержни"
	"quest.06FE7D3AE9C2FF01.quest_desc": ["Netherite Monstrosity — огромный босс из Cataclysm. Найди его арену в Нижнем мире и победи.", "Возьми хорошую броню, золотые яблоки и оружие с высоким уроном."]
	"quest.06FE7D3AE9C2FF01.title": "Нижний монстр"
	"quest.0DAD239B0AC82E63.quest_desc": ["Ancient Remnant спит в пустыне. Найди его и разбуди — но будь готов к долгому бою."]
	"quest.0DAD239B0AC82E63.title": "Древний остаток"
	"quest.0DB194EAAA030861.quest_desc": ["Собери глаза Эндера, найди крепость и активируй портал в Край.", "В Краю живёт дракон — финальный босс ванильного прогресса."]
	"quest.0DB194EAAA030861.title": "Край"
	"quest.05BF5EEE3B7C032D.quest_desc": ["Победи дракона Края. Разрушай кристаллы на обсидиановых столбах, потом атакуй самого дракона.", "Не забудь взять луки и стрелы."]
	"quest.05BF5EEE3B7C032D.title": "Дракон Края"
	"quest.040B017D33391EC6.quest_desc": ["Ender Guardian охраняет свои владения. Найди его арену и победи."]
	"quest.040B017D33391EC6.title": "Страж Края"
	"quest.0A0835DA9996CA44.quest_desc": ["Призови Иссушителя из черепов и песка душ. Победи его, чтобы получить звезду."]
	"quest.0A0835DA9996CA44.title": "Иссушитель"
	"quest.046339DAF909D25B.quest_desc": ["Визирь — могущественный некромант Goety. Найди его логово и положи конец его ритуалу."]
	"quest.046339DAF909D25B.title": "Визирь"
	"quest.01A79092B0F32F02.quest_desc": ["Ferrous Wroughtnaut — древний голем-воин. Победи его в честном бою."]
	"quest.01A79092B0F32F02.title": "Железный ветеран"
	"quest.0B481433B78922A5.quest_desc": ["Dead King — босс Iron’s Spellbooks. Он живёт в цитадели и очень силён.", "Возьми магическую броню и заклинания."]
	"quest.0B481433B78922A5.title": "Король мертвецов"
	"quest.082668E645C13BA9.quest_desc": ["Void Blossom — босс из Bosses of Mass Destruction. Победи его, чтобы получить уникальные трофеи."]
	"quest.082668E645C13BA9.title": "Цветок пустоты"
	"quest.09FF93584B0AD674.quest_desc": ["Королева валькирий охраняет серебряное подземелье Эфира. Победи её."]
	"quest.09FF93584B0AD674.title": "Королева валькирий"
	"quest.0DEBB53EF5F6F23A.quest_desc": ["Спустись в глубины и добудь осколки скалка. Там живёт Варден — не буди его без нужды.", "Собери 4 эхо-осколка."]
	"quest.0DEBB53EF5F6F23A.title": "Глубинная тьма"
	"quest.0B3673ADD17AFFE0.quest_desc": ["Другая сторона — тёмное измерение Deeper and Darker. Найди портал и войди.", "Там свои руды, мобы и боссы."]
	"quest.0B3673ADD17AFFE0.title": "Другая сторона"
	"quest.05EC79E08BA72A89.quest_desc": ["Найди древний город в глубинной тьме. Исследуй его, но не трогай скалк-катализаторы без подготовки."]
	"quest.05EC79E08BA72A89.title": "Древний город"
	"quest.09A3AF953679ABE5.quest_desc": ["Все руины, порталы и сокровища ты уже видел — самое время записать путь. Карта поможет не потерять маршрут и вернуться к важным местам.", "Скрафти пустую карту и используй её, чтобы начать наносить местность."]
	"quest.09A3AF953679ABE5.title": "Последний маршрут"
}
