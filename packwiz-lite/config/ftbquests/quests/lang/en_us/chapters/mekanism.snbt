{
	"quest.0D287F9A41255F7A.quest_desc": ["Паксель — это инструмент-гибрид: топор, кирка, лопата и молоток в одном. Переключается одной рукой.", "Сделай железный, золотой и алмазный паксели."]
	"quest.0D287F9A41255F7A.title": "Паксели"
	"quest.0493528483A11822.quest_desc": ["Осмий тяжелее стали, но держит удар лучше. Броня из осмия — для тех, кто ходит в Нижний мир без страха.", "Собери полный комплект осмиевой брони."]
	"quest.0493528483A11822.title": "Осмиевая броня"
	"quest.0FFDA4D24FA5FE77.quest_desc": ["Сталь — это то, что делает машину машиной. Стальная броня тяжелее осмиевой, но держит всё.", "Собери стальной шлем, нагрудник, поножи и сапоги."]
	"quest.0FFDA4D24FA5FE77.title": "Стальная броня"
	"quest.096FBD30281721C0.quest_desc": ["Инструмент из очищенного светокамня светит в темноте и не гаснет. Нужен тому, кто работает в шахте ночью.", "Сделай кирку, меч и щит из очищенного светокамня."]
	"quest.096FBD30281721C0.title": "Очищенный светокамень"
	"quest.0543300C8C135A49.quest_desc": ["Обсидиан держит удар, но тяжёлый. Очищенный обсидиан — уже можно носить на себе и рубить им.", "Сделай кирку, топор и щит из очищенного обсидиана."]
	"quest.0543300C8C135A49.title": "Очищенный обсидиан"
	"quest.012E9935E4FEE85F.quest_desc": ["Щит ставится в левую руку и принимает удар на себя. Лазуритовый красив, бронзовый крепок, светокаменный светит в темноте.", "Собери бронзовый, лазуритовый и светокаменный щиты."]
	"quest.012E9935E4FEE85F.title": "Щиты"
	"quest.0CBFD8E8127E53CB.quest_desc": ["Бронза — это медь и олово. Она не такая твёрдая, как сталь, но куётся легко и стоит копейки.", "Сделай бронзовую кирку, меч, лопату и мотыгу."]
	"quest.0CBFD8E8127E53CB.title": "Бронзовые инструменты"
	"quest.0D1621F4944DF00B.quest_desc": ["Пластик — это нефть, переработанная в лёгкий и прочный материал. Из него делают всё: от труб до обшивки.", "Собери чёрного, белого и аквапластика — по восемь штук каждого."]
	"quest.0D1621F4944DF00B.title": "Пластик"
	"quest.0653F5F441FB13D8.quest_desc": ["Рация связывает базу с кораблём и обходом. А обсидиановая бочка — это «не взрывается, если аккуратно».", "Собери рацию и обсидиановую бочку."]
	"quest.0653F5F441FB13D8.title": "Рация и обсидиановая бочка"
	"quest.04F12781628D9CF4.quest_desc": ["Лазурный камень красив и необычен, а из него получается лёгкая броня.", "Собери лазурный шлем, нагрудник, поножи и сапоги."]
	"quest.04F12781628D9CF4.title": "Лазурная броня"
}
