{
	"quest.FC122D05AFA785A1.quest_desc": ["Осмий — базовый металл Mekanism. Ищи серую руду под землёй.", "Собери 8 единиц сырья."]
	"quest.FC122D05AFA785A1.title": "Осмий"
	"quest.73D233AEF2CADBCB.quest_desc": ["Инфузер сплавляет металлы и создаёт сплавы. Поставь его и подключи энергию."]
	"quest.73D233AEF2CADBCB.title": "Металлургический инфузер"
	"quest.A9323B5494772BDF.quest_desc": ["Обогатитель превращает руду в пыль и удваивает добычу. Очень полезная машина на старте."]
	"quest.A9323B5494772BDF.title": "Обогатитель"
	"quest.1989A18675CD797E.quest_desc": ["Сталь делается в инфузере из железа и угля. Она нужна для машин, брони и реакторов."]
	"quest.1989A18675CD797E.title": "Сталь"
	"quest.DB8070E390B55C00.quest_desc": ["Теплогенератор даёт первую энергию. Поставь его рядом с лавой или горячим блоком.", "Энергия передаётся по кабелям."]
	"quest.DB8070E390B55C00.title": "Теплогенератор"
	"quest.7FBEFC61491F7EB1.quest_desc": ["Кабель соединяет генератор и машины. Сделай 8 штук и протяни линию."]
	"quest.7FBEFC61491F7EB1.title": "Универсальный кабель"
	"quest.67C4E43AA5D9CB00.quest_desc": ["Энергокуб хранит энергию. Поставь его между генератором и машинами, чтобы не простаивать."]
	"quest.67C4E43AA5D9CB00.title": "Энергохранилище"
	"quest.962BD5CC61EEE278.quest_desc": ["Цифровой шахтёр сам добывает руду в заданном регионе. Поставь его на рудное месторождение и подключи энергию.", "Это огромный шаг вперёд по ресурсам."]
	"quest.962BD5CC61EEE278.title": "Цифровой шахтёр"
	"quest.B055B1D760A77561.quest_desc": ["AE2 начинается с кварца Сертус. Найди жилы в пещерах и добудь 8 кристаллов."]
	"quest.B055B1D760A77561.title": "Кварц Сертус"
	"quest.10BA185F8184CF6E.quest_desc": ["Зарядник превращает обычный кварц в заряженный. Заряженный кварц нужен для продвинутых деталей."]
	"quest.10BA185F8184CF6E.title": "Зарядник"
	"quest.DA8DB7C5E01AF787.quest_desc": ["Гравировальщик делает печатные платы и процессоры. Поставь его и подай энергию."]
	"quest.DA8DB7C5E01AF787.title": "Гравировальщик"
	"quest.3C61831DA862E0FE.quest_desc": ["Контроллер — сердце сети. Он распределяет энергию и каналы между устройствами.", "Поставь его в центре будущей системы."]
	"quest.3C61831DA862E0FE.title": "Контроллер ME"
	"quest.4641092348515D75.quest_desc": ["Дисковод хранит ячейки с предметами. Вставь ячейку — и сеть увидит её содержимое."]
	"quest.4641092348515D75.title": "Дисковод"
	"quest.01AAF097BECC060F.quest_desc": ["Терминал — это интерфейс сети. Через него ты кладёшь и берёшь предметы.", "Поставь его рядом с дисководом."]
	"quest.01AAF097BECC060F.title": "Терминал"
	"quest.ECFD241102E72B61.quest_desc": ["Приёмник энергии подключает сеть AE2 к внешнему источнику. Без него контроллер не запустится."]
	"quest.ECFD241102E72B61.title": "Приёмник энергии"
	"quest.BE8B76E1AF1ADC39.quest_desc": ["Шаблон описывает рецепт для автосборки. Сделай 8 пустых шаблонов и закодируй их в терминале."]
	"quest.BE8B76E1AF1ADC39.title": "Шаблоны"
	"quest.D9D02AE010E528A9.quest_desc": ["Сборщик выполняет рецепты из шаблонов. Поставь его рядом с шаблонным провайдером."]
	"quest.D9D02AE010E528A9.title": "Молекулярный сборщик"
	"quest.9BDAEC055CF53B00.quest_desc": ["Настрой шаблон, подключи сборщик и запусти крафт через терминал. С этого момента сеть собирает предметы сама."]
	"quest.9BDAEC055CF53B00.title": "Автокрафт"
	"quest.EE0A2386B6967256.quest_desc": ["Беспроводной терминал даёт доступ к сети издалека. Подключи его к сети и наслаждайся."]
	"quest.EE0A2386B6967256.title": "Беспроводной терминал"
	"quest.B8A3FF0721742D97.quest_desc": ["Квантовые кольца соединяют две сети на любом расстоянии. Это высший уровень AE2.", "Построй две связанные сети и почувствуй себя архимагом логистики."]
	"quest.B8A3FF0721742D97.title": "Квантовая сеть"
	"quest.428E7A5252289B41.quest_desc": ["Мелких генераторов хватает для лампочек и печей, но не для фабрик. Элитное энергохранилище — сердце больших механизмов.", "Оно подержит энергию для станков, крафтеров и автокрафта, когда нагрузка вырастет."]
	"quest.428E7A5252289B41.title": "Реакторный запас"
}
