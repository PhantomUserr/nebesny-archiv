{
	"quest.087BBA1E7C4F987F.quest_desc": ["Ars Nouveau начинается с книги заклинаний. Скрафти её и открой — внутри дерево заклинаний.", "Заклинания собираются из глифов. Начни с простого: «Свет» или «Снаряд»."]
	"quest.087BBA1E7C4F987F.title": "Книга новичка"
	"quest.02A79940E91D1BF8.quest_desc": ["Жезл — инструмент для создания заклинаний и ритуалов в Ars Nouveau.", "Сделай его вместе с книгой новичка: на жезле можно наносить глифы, из которых собираются заклинания."]
	"quest.02A79940E91D1BF8.title": "Жезл"
	"quest.07E1FE8E0EBF40AE.quest_desc": ["Source — мана Ars Nouveau. Банка источника собирает её из цветов и растений вокруг.", "Поставь банку рядом с садом."]
	"quest.07E1FE8E0EBF40AE.title": "Источник магии"
	"quest.02DEF308668B69DB.quest_desc": ["Имбуирование заряжает предметы магией. Поставь камеру и подай в неё source."]
	"quest.02DEF308668B69DB.title": "Имбуирование"
	"quest.0787325E0953E1C5.quest_desc": ["Enchanting Apparatus создаёт магические предметы и улучшения. Поставь его на пьедесталы."]
	"quest.0787325E0953E1C5.title": "Чары"
	"quest.0BF47B19C711FDD0.quest_desc": ["Жаровня запускает ритуалы. Положи в неё нужные предметы и подожги.", "Ритуалы умеют вызывать дождь, летать и многое другое."]
	"quest.0BF47B19C711FDD0.title": "Ритуальная жаровня"
	"quest.062C252126931DE0.quest_desc": ["Iron’s Spellbooks — вторая магическая школа. Скрафти железную книгу и открой её.", "Заклинания здесь изучаются через свитки и стол начертания."]
	"quest.062C252126931DE0.title": "Книга заклинаний"
	"quest.06999FB97AAF9DC5.quest_desc": ["На столе начертания ты создаёшь свитки заклинаний. Поставь его рядом с книгой."]
	"quest.06999FB97AAF9DC5.title": "Стол начертания"
	"quest.07053DA085042999.quest_desc": ["На арканной наковальне улучшают снаряжение и накладывают магические свойства."]
	"quest.07053DA085042999.title": "Арканная наковальня"
	"quest.049C8CEA3AB150F8.quest_desc": ["Эссенция — топливо для магии Iron’s Spellbooks. Добывается с мобов и из руды.", "Собери 8 штук."]
	"quest.049C8CEA3AB150F8.title": "Арканная эссенция"
	"quest.0CC3472B3AF2958A.quest_desc": ["Malum — мрачная магия душ, и рунный верстак — её первый шаг.", "Поставь верстак рядом с домом или в мастерской и открой его, чтобы посмотреть рецепты первых рун."]
	"quest.0CC3472B3AF2958A.title": "Рунный верстак"
	"quest.03DB3D5C95AED671.quest_desc": ["Алтарь принимает подношения и создаёт духовные предметы. Поставь его и положи ингредиенты."]
	"quest.03DB3D5C95AED671.title": "Алтарь духов"
	"quest.0176ABE8D5143C05.quest_desc": ["Коса собирает души с убитых мобов. Сделай грубую косу и испытай её в бою."]
	"quest.0176ABE8D5143C05.title": "Коса"
	"quest.0F660D65109DEE22.quest_desc": ["Банка хранит души. Без неё души пропадают после смерти моба."]
	"quest.0F660D65109DEE22.title": "Банка духов"
	"quest.08DAA256D111E987.quest_desc": ["Soul Stained Steel — прочный магический металл. Сплавы делаются на алтаре."]
	"quest.08DAA256D111E987.title": "Сталь душ"
	"quest.0BD26CFD5683648B.quest_desc": ["Goety — школа некромантии. Начни с тёмного жезла и книги."]
	"quest.0BD26CFD5683648B.title": "Тёмный жезл"
	"quest.031234A1B12295C2.quest_desc": ["Тёмный алтарь создаёт и усиливает посохи и фокусы. Поставь его в тени."]
	"quest.031234A1B12295C2.title": "Тёмный алтарь"
	"quest.0F7367F8E895B1DE.quest_desc": ["Spectrum — магия цвета. Палитра пигментов открывает первые рецепты."]
	"quest.0F7367F8E895B1DE.title": "Палитра пигментов"
	"quest.0222F66BF8474764.quest_desc": ["Fusion Shrine сплавляет материалы в магические сплавы. Поставь её на открытом месте."]
	"quest.0222F66BF8474764.title": "Кузня слияния"
	"quest.0E956E2D733D08C5.quest_desc": ["Enchanter накладывает зачарования без стола. Он открывает доступ к сильным эффектам."]
	"quest.0E956E2D733D08C5.title": "Зачарователь"
	"quest.094FA70507FCE355.quest_desc": ["Theurgy — алхимия, которая разбирает вещества на первоэлементы. Начни с печи кальцинации.", "Это необязательная ветка, но она даёт редкие материалы."]
	"quest.094FA70507FCE355.title": "Алхимия Теургии"
	"quest.073E40A96223605D.quest_desc": ["Котёл сжижения плавит материалы в эссенции. Поставь его под открытым небом."]
	"quest.073E40A96223605D.title": "Котёл сжижения"
	"quest.0F05C2E6F3C5289F.quest_desc": ["Эфир — светлое измерение над облаками. Собери рамку портала из светящегося камня и зажги её."]
	"quest.0F05C2E6F3C5289F.title": "Рамка портала в Эфир"
	"quest.0626DFC8FBBD8134.quest_desc": ["Войди в портал и окажись в Эфире. Там свои руды, мобы и подземелья.", "Не забудь взять еду и оружие."]
	"quest.0626DFC8FBBD8134.title": "Шаг в Эфир"
	"quest.0676C35EBD45F8CB.quest_desc": ["Магия Архива пошла в гору: от книги новичка до архимагской. Книга архимага — это уже не просто свиток, а подлинное могущество.", "Собери её и проверь силу новых заклинаний в безопасном месте."]
	"quest.0676C35EBD45F8CB.title": "Архимаг"
}
