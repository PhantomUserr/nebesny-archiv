{
	"quest.DCE30778EF9369B9.quest_desc": ["Сделай грядки мотыгой, посади семена и подожди. Пшеница нужна для хлеба, сена и торговли.", "Вода ускоряет рост: одно ведро воды увлажняет грядки в радиусе 4 блоков."]
	"quest.DCE30778EF9369B9.title": "Пшеничное поле"
	"quest.973181FAF2164EFB.quest_desc": ["Мотыга превращает землю в грядку. Без неё не вырастить ничего, кроме тыкв и арбузов.", "Сделай каменную или железную — деревянная быстро ломается."]
	"quest.973181FAF2164EFB.title": "Мотыга"
	"quest.4B17CD8051FC8093.quest_desc": ["Разведи коров: они дают кожу, мясо и молоко. Примани их пшеницей и заведи в загон.", "Убей трёх коров, чтобы закрыть базовую потребность в коже."]
	"quest.4B17CD8051FC8093.title": "Коровы и уют"
	"quest.C7F08D97E457371F.quest_desc": ["Кастрюля готовит сложные блюда: супы, рагу, жаркое. Они восстанавливают больше голода, чем сырое мясо.", "Поставь кастрюлю на огонь или на лагерный костёр."]
	"quest.C7F08D97E457371F.title": "Походная кухня"
	"quest.2A72B93C9C7D30CA.quest_desc": ["?? ????? ????? ???????? ????? ? ???????? ????? ??? ????????. ?????? ??????????? ????? ? ????? ? ????? ? ???? ??? ???? ????? ??????? ?? ??????.", "??? ??? ???????? ????? ??????? ?????, ????? ???????? ???? ??? ?????? ???????? ??? ?????."]
	"quest.2A72B93C9C7D30CA.title": "??????????? ?????"
	"quest.908715FBBA1D7386.quest_desc": ["Плита готовит еду без топлива и работает даже под дождём. Поставь её в кухне.", "Внутри можно хранить еду — она не испортится."]
	"quest.908715FBBA1D7386.title": "Плита"
	"quest.DB54F48FFA2479F4.quest_desc": ["Сундук — это хорошо, но модовые сундуки вместительнее и выглядят как настоящая мебель.", "Сделай хотя бы один сундук из Sophisticated Storage."]
	"quest.DB54F48FFA2479F4.title": "Кладовая"
	"quest.6098C1F927FE7DB3.quest_desc": ["Ящики хранят один тип предмета, зато очень вместительно. Идеально для камня, досок и руды.", "Сделай пару простых компактных ящиков."]
	"quest.6098C1F927FE7DB3.title": "Ящики для мелочей"
	"quest.FCE7F8943ABC2726.quest_desc": ["Спальный мешок можно положить где угодно и взять с собой. Он не задаёт точку возрождения, зато экономит место.", "Пригодится в походах и на борту корабля."]
	"quest.FCE7F8943ABC2726.title": "Место для сна"
	"quest.D75B2107685C9E53.quest_desc": ["Фонари светят ярче факелов и красиво смотрятся. Расставь их вокруг дома, чтобы мобы не спавнились.", "Сделай 6 фонарей."]
	"quest.D75B2107685C9E53.title": "Свет в каждом углу"
	"quest.77A745D21F71AFDD.quest_desc": ["Стекло делается из песка в печи. Из него получаются окна и блоки для декора.", "Собери 16 стеклянных блоков."]
	"quest.77A745D21F71AFDD.title": "Окна"
	"quest.A1757138A17DB988.quest_desc": ["Ступени нужны для крыши, лестниц и нормального дома. Сделай 16 штук из досок."]
	"quest.A1757138A17DB988.title": "Крыша и ступени"
	"quest.270586BDB3450F4F.quest_desc": ["Двери защищают от мобов и не пропускают дождь.", "Поставь две двери: одна станет главным входом, вторая — для гостевой, чердака или заднего двора."]
	"quest.270586BDB3450F4F.title": "???? ? ???"
	"quest.3B3A09951C876303.quest_desc": ["Построй дом хотя бы 9×9 с крышей, окнами и дверью. Внутри должны поместиться кровать, верстак, печь и сундуки.", "Не обязательно строить дворец — главное, чтобы было где переждать ночь."]
	"quest.3B3A09951C876303.title": "Настоящий дом"
	"quest.81AF63F940B03D1D.quest_desc": ["Камень возврата — это точка телепорта. Активируй его у дома и запомни: теперь можно вернуться сюда из любого места.", "Позже сделай варп-камень, чтобы телепортироваться к нему из инвентаря."]
	"quest.81AF63F940B03D1D.title": "Камень возврата"
	"quest.877D68AD2E964BF6.quest_desc": ["Поставь вторую кровать и сундук для гостя. В этом мире можно играть вместе — место хватит всем.", "Если друг ещё не подключился, просто подготовь комнату."]
	"quest.877D68AD2E964BF6.title": "Дом для друга"
	"quest.76EA979E739385F9.quest_desc": ["Сад и дом начинаются с порядка: грядки, еда, уют. Примани пчёл на цветущие грядки и заведи улей.", "Мёд пригодится для еды и торговли, а улей станет маленькой достопримечательностью твоего участка."]
	"quest.76EA979E739385F9.title": "Семейный улей"
}
