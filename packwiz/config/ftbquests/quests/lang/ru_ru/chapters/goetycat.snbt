{
	"quest.00628DD93DAFC9BA.quest_desc": ["Визирь оставляет после себя очаги — места, где сила скопилась и ждёт. Эссенция без очага — просто пыль.", "Собери эссенцию бездны, первоначальную эссенцию и два духа: арканного и воинского."]
	"quest.00628DD93DAFC9BA.title": "Очаги силы"
	"quest.0BC667D69F5B1E1D.quest_desc": ["Могила, каменная пирамида, склеп — в каждом из них копится своя дрянь.", "Собери очаги проклятой могилы, проклятой пирамиды и проклятого склепа."]
	"quest.0BC667D69F5B1E1D.title": "Проклятые очаги"
	"quest.080AEA36DE080ABC.quest_desc": ["Поле битвы, землетрясение, песчаная буря — очаги, которые бьют по площади.", "Собери очаг поля битвы, очаг землетрясения и очаг песчаной бури."]
	"quest.080AEA36DE080ABC.title": "Очаги battlefield"
	"quest.0E3ABCB508D5B7D5.quest_desc": ["Пустота — это то, что осталось от Старого Стирателя. С ней не спорят, её запечатывают.", "Собери очаг пустотной руны и очаг пустотного вихря, а также блок пустотной плесени."]
	"quest.0E3ABCB508D5B7D5.title": "Пустотные очаги"
	"quest.0324C1497D153CF6.quest_desc": ["Станок снимает ткань с существ и собирает из неё броню. Механическое ядро делает всё остальное.", "Собери ткацкий станок, механическое ядро, механизированный железный блок и незеритовую броню."]
	"quest.0324C1497D153CF6.title": "Ткацкий станок"
	"quest.0DFFAFA6EA948541.quest_desc": ["Драугры и эндер-големы не умирают — их надо победить или разбить. Черепа нужны для трофеев.", "Найди череп эндер-голема и череп останка, а также яйца некромантов и королевских слуг."]
	"quest.0DFFAFA6EA948541.title": "Немёртвые слуги"
	"quest.03943758232C81DF.quest_desc": ["Трибуны глубин, течение и вздыхание волн — то, что топит. Лучше встретить их на суше, чем на дне.", "Собери очаг трибуны глубин, очаг течения и очаг вздыхания волн."]
	"quest.03943758232C81DF.title": "Очаги глубин"
}
