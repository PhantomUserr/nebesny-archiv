{
	"quest.7BE83E155D670629.quest_desc": ["Аэронавтика требует платину. Ищи руду в глубоких пещерах или перерабатывай породу.", "Собери 8 единиц сырья."]
	"quest.7BE83E155D670629.title": "Платина"
	"quest.B0CA6DDA0DA06FA9.quest_desc": ["Переплавь сырьё в слитки. Платина идёт на корпуса, двигатели и прочные детали."]
	"quest.B0CA6DDA0DA06FA9.title": "Платиновые слитки"
	"quest.8E943B3B705562A2.quest_desc": ["Крылья создают подъёмную силу. Чем больше крыльев, тем тяжелее корабль можно поднять.", "Сделай хотя бы два крыла."]
	"quest.8E943B3B705562A2.title": "Крылья"
	"quest.9BCE2F3F797C3010.quest_desc": ["Самый простой двигатель. Кладёшь топливо, подаёшь красный сигнал — и корабль летит.", "Хорош для первого корабля, но топливо быстро кончается."]
	"quest.9BCE2F3F797C3010.title": "Твердотопливный двигатель"
	"quest.C7D8DB010D9163D3.quest_desc": ["Жидкостный двигатель работает на топливе из бака. Он мощнее и экономичнее твердотопливного.", "Поставь бак рядом и подключи трубу."]
	"quest.C7D8DB010D9163D3.title": "Жидкостный двигатель"
	"quest.EAB760A1987CC091.quest_desc": ["Векторный двигатель можно поворачивать — он меняет направление тяги. С ним корабль слушается руля.", "Поставь его на корму."]
	"quest.EAB760A1987CC091.title": "Векторный двигатель"
	"quest.49A58BC10BD116C5.quest_desc": ["Адаптер наклоняет двигатель или крыло. Помогает управлять кораблём и держать курс."]
	"quest.49A58BC10BD116C5.title": "Наклонный адаптер"
	"quest.8A84F7CDDD6F9B9F.quest_desc": ["Auto Glue склеивает блоки в единую конструкцию. Без него корабль развалится на части.", "Нанеси клей на блоки и собери корпус."]
	"quest.8A84F7CDDD6F9B9F.title": "Клей для конструкции"
	"quest.BA34900E37BC71CE.quest_desc": ["Палка помогает двигать и поворачивать блоки конструкции. Также ей можно настроить сборку."]
	"quest.BA34900E37BC71CE.title": "Монтажная палка"
	"quest.2EA41D699EA1B25B.quest_desc": ["Control Desk — главный пульт корабля. С него задаётся тяга и направление.", "Поставь его в кабине."]
	"quest.2EA41D699EA1B25B.title": "Пульт управления"
	"quest.D07F474A70CFA5E5.quest_desc": ["Джойстик даёт плавное управление. Подключи его к пульту и двигателям."]
	"quest.D07F474A70CFA5E5.title": "Джойстик"
	"quest.293178B6F16D8B61.quest_desc": ["Гироскоп стабилизирует корабль. С ним проще держать горизонт и не кувыркаться в воздухе."]
	"quest.293178B6F16D8B61.title": "Гироскоп"
	"quest.CEBAF0C396DD0220.quest_desc": ["Балласт помогает центровать корабль. Если нос клюёт вниз — добавь балласт.", "Сделай 4 блока балласта."]
	"quest.CEBAF0C396DD0220.title": "Балласт"
	"quest.0B72EE4A4210CBCD.quest_desc": ["Собери корпус, поставь крылья, двигатель, пульт и балласт. Склей всё в одну конструкцию и проверь, что она держится.", "Не спеши: лучше маленький корабль, который летает, чем огромный, который падает."]
	"quest.0B72EE4A4210CBCD.title": "Собери корабль"
	"quest.A97E8E373C21F592.quest_desc": ["?????? ??????? ?? ?????: ??????, ?????????, ????? ? ???????. ??????? ????????? ???????, ??????? ??????, ????? ?????????, ??????? ??????.", "????????? ? ?????? ? ??????? ???? ?? 100 ?????? ?? ??????. ???????? ?????? ? ?????? ???????? ?????????????? ???????. ???? ??????? ??????, ??????? ??????, ???? ? ????."]
	"quest.A97E8E373C21F592.title": "?????? ?????"
	"quest.B8DB98D61E10E7E7.quest_desc": ["Блок заявки защищает твой корабль от чужих рук.", "Поставь его на борт корабля — после этого другие игроки не смогут ломать твой корабль без твоего разрешения."]
	"quest.B8DB98D61E10E7E7.title": "?????????? ????"
	"quest.DF8EE7CCEE220803.quest_desc": ["Из рельсов и вагонетки можно собрать настоящие горки. Поставь вагонетку на рельсы и запусти."]
	"quest.DF8EE7CCEE220803.title": "Американские горки"
	"quest.23B8FBD8E7AC3EBB.quest_desc": ["Один корабль — один пилот, а Архив большой. Подготовь запас крыльев для второго корабля или ремонта.", "Ангар — стартовая площадка, где новый корабль будет собираться и ждать своего часа."]
	"quest.23B8FBD8E7AC3EBB.title": "Крылатый ангар"
}
