{
	"quest.0DCE30778EF9369B.quest_desc": ["Сделай грядки мотыгой, посади семена и подожди. Пшеница нужна для хлеба, сена и торговли.", "Вода ускоряет рост: одно ведро воды увлажняет грядки в радиусе 4 блоков."]
	"quest.0DCE30778EF9369B.title": "Пшеничное поле"
	"quest.0973181FAF2164EF.quest_desc": ["Мотыга превращает землю в грядку. Без неё не вырастить ничего, кроме тыкв и арбузов.", "Сделай каменную или железную — деревянная быстро ломается."]
	"quest.0973181FAF2164EF.title": "Мотыга"
	"quest.04B17CD8051FC809.quest_desc": ["Разведи коров: они дают кожу, мясо и молоко. Примани их пшеницей и заведи в загон.", "Убей трёх коров, чтобы закрыть базовую потребность в коже."]
	"quest.04B17CD8051FC809.title": "Коровы и уют"
	"quest.0C7F08D97E457371.quest_desc": ["Кастрюля готовит сложные блюда: супы, рагу, жаркое. Они восстанавливают больше голода, чем сырое мясо.", "Поставь кастрюлю на огонь или на лагерный костёр."]
	"quest.0C7F08D97E457371.title": "Походная кухня"
	"quest.02A72B93C9C7D30C.quest_desc": ["На доске можно нарезать овощи и готовить блюда для кастрюли. Сделай разделочную доску — палки и доски у тебя уже есть после квестов на дерево.", "Нож для разделки можно сделать позже, когда появится кожа или другой материал для ручки."]
	"quest.02A72B93C9C7D30C.title": "Разделочная доска"
	"quest.0908715FBBA1D738.quest_desc": ["Плита готовит еду без топлива и работает даже под дождём. Поставь её в кухне.", "Внутри можно хранить еду — она не испортится."]
	"quest.0908715FBBA1D738.title": "Плита"
	"quest.0DB54F48FFA2479F.quest_desc": ["Сундук — это хорошо, но модовые сундуки вместительнее и выглядят как настоящая мебель.", "Сделай хотя бы один сундук из Sophisticated Storage."]
	"quest.0DB54F48FFA2479F.title": "Кладовая"
	"quest.06098C1F927FE7DB.quest_desc": ["Ящики хранят один тип предмета, зато очень вместительно. Идеально для камня, досок и руды.", "Сделай пару простых компактных ящиков."]
	"quest.06098C1F927FE7DB.title": "Ящики для мелочей"
	"quest.0FCE7F8943ABC272.quest_desc": ["Спальный мешок можно положить где угодно и взять с собой. Он не задаёт точку возрождения, зато экономит место.", "Пригодится в походах и на борту корабля."]
	"quest.0FCE7F8943ABC272.title": "Место для сна"
	"quest.0D75B2107685C9E5.quest_desc": ["Фонари светят ярче факелов и красиво смотрятся. Расставь их вокруг дома, чтобы мобы не спавнились.", "Сделай 6 фонарей."]
	"quest.0D75B2107685C9E5.title": "Свет в каждом углу"
	"quest.077A745D21F71AFD.quest_desc": ["Стекло делается из песка в печи. Из него получаются окна и блоки для декора.", "Собери 16 стеклянных блоков."]
	"quest.077A745D21F71AFD.title": "Окна"
	"quest.0A1757138A17DB98.quest_desc": ["Ступени нужны для крыши, лестниц и нормального дома. Сделай 16 штук из досок."]
	"quest.0A1757138A17DB98.title": "Крыша и ступени"
	"quest.0270586BDB3450F4.quest_desc": ["Двери защищают от мобов и не пропускают дождь.", "Поставь две двери: одна станет главным входом, вторая — для гостевой, чердака или заднего двора."]
	"quest.0270586BDB3450F4.title": "Вход в дом"
	"quest.03B3A09951C87630.quest_desc": ["Построй дом хотя бы 9×9 с крышей, окнами и дверью. Внутри должны поместиться кровать, верстак, печь и сундуки.", "Не обязательно строить дворец — главное, чтобы было где переждать ночь."]
	"quest.03B3A09951C87630.title": "Настоящий дом"
	"quest.081AF63F940B03D1.quest_desc": ["Камень возврата — это точка телепорта. Активируй его у дома и запомни: теперь можно вернуться сюда из любого места.", "Позже сделай варп-камень, чтобы телепортироваться к нему из инвентаря."]
	"quest.081AF63F940B03D1.title": "Камень возврата"
	"quest.0877D68AD2E964BF.quest_desc": ["Поставь вторую кровать и сундук для гостя. В этом мире можно играть вместе — место хватит всем.", "Если друг ещё не подключился, просто подготовь комнату."]
	"quest.0877D68AD2E964BF.title": "Дом для друга"
	"quest.076EA979E739385F.quest_desc": ["Сад и дом начинаются с порядка: грядки, еда, уют. Примани пчёл на цветущие грядки и заведи улей.", "Мёд пригодится для еды и торговли, а улей станет маленькой достопримечательностью твоего участка."]
	"quest.076EA979E739385F.title": "Семейный улей"
}
