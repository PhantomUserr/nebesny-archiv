{
	"quest.0FAD8AF03701E29D.quest_desc": ["Пушка — не красивая игрушка, а способ защитить корабль. Но начинается всё с бронзы: ствол, казённик, лафет.", "Выплав�� бронзу и отлей из неё блок — это основа любой пушки."]
	"quest.0FAD8AF03701E29D.title": "Бронза для пушек"
	"quest.077B751380D41E7F.quest_desc": ["Ствол, казённик, лафет и дульный тормоз — четыре детали, из которых собирается орудие.", "Собери пушку целиком и поставь её на лафет."]
	"quest.077B751380D41E7F.title": "Сборка пушки"
	"quest.057CE1B7C90632A9.quest_desc": ["Пушка без заряда — просто труба. Снаряды, картечь и разрывные ядра делают её оружием.", "Собери заряжатель и большой патрон."]
	"quest.057CE1B7C90632A9.title": "Заряжание"
	"quest.0CED6395D16C147A.quest_desc": ["Бронебойный снаряд пробивает любую броню. Из него делают и картечь, и готовые заряды.", "Сделай бронебойную гранату и несколько готовых патронов."]
	"quest.0CED6395D16C147A.title": "Бронебойный снаряд"
	"quest.0CEA4D6A5E95A3A1.quest_desc": ["Автопушка стреляет сама: только подкладывай патроны. На корабле это дешевле, чем расставлять людей.", "Собери автопушку и её ствол."]
	"quest.0CEA4D6A5E95A3A1.title": "Автопушка"
	"quest.06765546D7F69201.quest_desc": ["Энергизатор — это сердце новых машин: он берёт вращение и отдаёт его в виде энергии.", "Собери базовый энергизатор и базовый мотор."]
	"quest.06765546D7F69201.title": "Энергизаторы"
	"quest.03B1F95E0AF919A2.quest_desc": ["Продвинутый энергизатор держит больше энергии и не перегревается. Усиленный — не перегревается вообще.", "Собери продвинутый и усиленный энергизаторы."]
	"quest.03B1F95E0AF919A2.title": "Продвинутый энергизатор"
	"quest.0565A70A961C87D9.quest_desc": ["Двигатель Стирлинга работает от разницы температур: подогрел — получил вращение. Тепло он берёт у всего вокруг.", "Собери двигатель Стирлинга и тепловую трубу."]
	"quest.0565A70A961C87D9.title": "Двигатель Стирлинга"
	"quest.0AB146D9AECC1D9D.quest_desc": ["Магниты удерживают ферромагнитные детали и блокируют заряд. Редоземельные магниты держат в разы сильнее.", "Сделай многослойный магнит и незеритовый магнит."]
	"quest.0AB146D9AECC1D9D.title": "Магниты"
	"quest.060EA52AB4CFDD9B.quest_desc": ["Торий — редкий металл. Из него делают топливо реактора и магниты.", "Найди ториевую руду и выплавь из неё металл."]
	"quest.060EA52AB4CFDD9B.title": "Торий"
	"quest.0C82D55C6E3001C4.quest_desc": ["Реактор даёт энергию, но требует топлива, охлаждения и выдержки. Корпус, стержень, стекло — и всё это безопасно работает.", "Собери корпус реактора и установи в него стержень."]
	"quest.0C82D55C6E3001C4.title": "Реактор"
	"quest.0060B8D1EC8FC665.quest_desc": ["Дизель делают из нефти: сначала перегоняют в сырую нефть, потом в бензин, а уже из него — в дизель и биоэтанол.", "Собери ведро дизеля и ведро бензина."]
	"quest.0060B8D1EC8FC665.title": "Дизельное топливо"
	"quest.05A15B2FB9DD5883.quest_desc": ["Дизельный двигатель крутится сильнее и жрёт больше топлива. Большой — ещё сильнее.", "Собери большой дизельный двигатель."]
	"quest.05A15B2FB9DD5883.title": "Дизельный двигатель"
	"quest.0C3CB9C77518EDA0.quest_desc": ["Ферментёр перерабатывает биомассу в этанол, а перегонный контроллер управляет всей перегонкой.", "Собери ферментёр и контроллер перегонки."]
	"quest.0C3CB9C77518EDA0.title": "Ферментёр и перегонка"
	"quest.07CAE302B43DFF17.quest_desc": ["Нефть добывают насосом-качалкой: он качает сырьё из-под земли. Сырьё потом фильтруют и перегоняют.", "Собери качалку и сканер нефти."]
	"quest.07CAE302B43DFF17.title": "Насосная станция"
	"quest.086EDEED9C61D3EF.quest_desc": ["Химический распылитель разносит смеси по полю, а химическая турель — то же, но разрушительно.", "Собери распылитель и турель."]
	"quest.086EDEED9C61D3EF.title": "Химия"
	"quest.09515358EDE7B6FF.quest_desc": ["Зачаровывание в больших масштабах: ручная печать заменяется печатным станком, а книга — книжным шкафом.", "Собери чаропечатный станок и книжный шкаф."]
	"quest.09515358EDE7B6FF.title": "Промышленное зачарование"
	"quest.0B5EAC5180F1B40F.quest_desc": ["Огненный зачарователь работает на blaze-порошке и зачаровывает предметы без книг. Ручной — медленный, механический — быстрый.", "Собери механический точильный круг и зачарователь."]
	"quest.0B5EAC5180F1B40F.title": "Огненный зачарователь"
	"quest.077722B459594198.quest_desc": ["Опыт можно не только качать убийствами. Торт из опыта, котёл и фонарь превращают его в пищу и свет.", "Сделай торт из опыта и фонарь опыта."]
	"quest.077722B459594198.title": "Опыт в виде торта"
	"quest.0DDE699BDD9968AC.quest_desc": ["Драконья кровь в жидком виде — красиво, но опасно: хрупкий резервуар может лопнуть. Специальный бак выдержит.", "Собери бак для драконьей крови и хрупкий резервуар в броне."]
	"quest.0DDE699BDD9968AC.title": "Драконья кровь"
	"quest.0250CF78752E6454.quest_desc": ["Инструменты из латуни крепче железных и легче. А медный магнит притягивает только то, что нужно.", "Собери латунный меч, латунную кирку и медный магнит."]
	"quest.0250CF78752E6454.title": "Латунные инструменты"
	"quest.0A0CF84B9D758805.quest_desc": ["Реактивный ранец на груди даёт короткий толчок вверх. С ним прыгают выше, чем должны, — а на корабле это иногда спасает жизнь.", "Собери латунный реактивный нагрудник."]
	"quest.0A0CF84B9D758805.title": "Реактивные доспехи"
	"quest.0117FD36BAA1BA22.quest_desc": ["Дрон — это маленькая машина, которая ездит сама. Управляет ею контроллер, а чинит всё это блок-пикер.", "Собери контроллер дрона и запасной ремонтный блок."]
	"quest.0117FD36BAA1BA22.title": "Дроны"
	"quest.08AB01C9FD769699.quest_desc": ["Шоколад делают из какао-бобов, а формуют в конфеты уже на Create. Получается четыре вида — от белого до чёрного.", "Сделай обычную, рубиновую, белую и чёрную конфету."]
	"quest.08AB01C9FD769699.title": "Шоколад"
	"quest.043D298E7F50BF9B.quest_desc": ["Винт — сердце любой летающей машины. Деревянный простой, андезитовый крепкий, а умный и гироскопический — точный.", "Собери деревянный, андезитовый и умный винты."]
	"quest.043D298E7F50BF9B.title": "Винты"
	"quest.0F5F5A3F8FB1F4EA.quest_desc": ["Подшипник держит винт на валу и позволяет ему крутиться свободно. Гироскопический — ещё и стабилизирует.", "Собери обычный и гироскопический подшипники."]
	"quest.0F5F5A3F8FB1F4EA.title": "Подшипник винта"
	"quest.0BF8E4A0E631082B.quest_desc": ["Очки пилота показывают скорость, высоту и заряд двигателя. Без них в кабине ничего не видно.", "Сделай очки пилота и установи их в кабине."]
	"quest.0BF8E4A0E631082B.title": "Очки пилота"
	"quest.0FB42A354FCD9385.quest_desc": ["Левитит — минерал, который отталкивает от земли. Из него делают смесь, а на ней уже летают.", "Найди левитит и собери перламутровый."]
	"quest.0FB42A354FCD9385.title": "Левитит"
	"quest.04162F3301BE4F81.quest_desc": ["Обёртка замыкает силовые линии: трубы и валы внутри неё работают как единое целое.", "Собери обёртку силового поля с закрытым валом."]
	"quest.04162F3301BE4F81.title": "Обёртка силового поля"
	"quest.061F3040BEAB3856.quest_desc": ["На воде флот держится на парусах. Белый парус ставится на лодку, а ветряная флюгерная труба показывает направление.", "Сделай белый парус и ветряную флюгерную трубу."]
	"quest.061F3040BEAB3856.title": "Паруса"
	"quest.0D31D391E2003F7D.quest_desc": ["Лодка с мотором, рулём и якорем — это уже не лодка, а маленькое судно. Проверь, что руль работает.", "Собери лодочный мотор, руль и якорь."]
	"quest.0D31D391E2003F7D.title": "Лодка"
	"quest.09A71F4C85E26E31.quest_desc": ["Под лодкой нужны балластные танки, кислород и гребной винт. Без балласта она не уйдёт на глубину.", "Собери балластный танк, балластный вентиль и гребной винт."]
	"quest.09A71F4C85E26E31.title": "Подводная лодка"
	"quest.047491E1F5EDBC90.quest_desc": ["Под водой нужен кислород. Диффузор и мембрана превращают воду в воздух, а камера декомпрессии выпускает наружу.", "Собери диффузор кислорода и камеру декомпрессии."]
	"quest.047491E1F5EDBC90.title": "Кислород"
	"quest.01A7B761B7B81B0C.quest_desc": ["Сонар показывает, что вокруг: рифы, руины, чужие корабли. Под водой это единственный способ не пройти мимо.", "Собери сонар и промышленную сирену."]
	"quest.01A7B761B7B81B0C.title": "Сонар"
	"quest.085FEED0DC5CE470.quest_desc": ["Мина — это не снаряд, а приманка: она стоит на дне и ждёт. Для подводной охоты — лучшее.", "Собери подводную мину и крюк-арест."]
	"quest.085FEED0DC5CE470.title": "Подводная мина"
}
