{
	"quest.0D5399006ADFE33F.quest_desc": ["Кертаусский кварц — основа энергетики AE2. Он растёт кристаллами, а из них делают энергетические и флюиксовые кристаллы.", "Найди жилу кварца и вырасти кристалл."]
	"quest.0D5399006ADFE33F.title": "Кертаусский кварц"
	"quest.0670CDB18C08EE03.quest_desc": ["Заряженный кварц светится и работает в три раза лучше обычного. Но чтобы зарядить кристалл, нужен специальный механизм.", "Вырасти заряженный кристалл и заряди его."]
	"quest.0670CDB18C08EE03.title": "Заряженный кварц"
	"quest.02AD5AAE2FABF092.quest_desc": ["Камера роста ускоряет кристалл в разы, агрегатор выращивает сразу несколько, а вибрационная камера ускоряет всё рядом.", "Собери камеру роста и агрегатор."]
	"quest.02AD5AAE2FABF092.title": "Рост кристаллов"
	"quest.0249EF4E4B39AB51.quest_desc": ["Пульверизатор разбирает предметы на составляющие, а гравитационная камера удерживает их в воздухе.", "Собери пульверизатор и гравитационную камеру."]
	"quest.0249EF4E4B39AB51.title": "Пульверизатор и гравитация"
	"quest.0ED5FB06E979B99B.quest_desc": ["Гравировщик переносит схему с печати на карту. Это мост между «бумагой» и «машиной».", "Собери гравировщик и заготовку печати."]
	"quest.0ED5FB06E979B99B.title": "Гравировщик схем"
	"quest.07CA1B7D2DF4365B.quest_desc": ["Эндер-кристаллы не хранят предметы, а связывают. Интерфейс эндера, расширенный интерфейс, эндер-связка — на этом стоит вся эндер-сеть.", "Сделай эндер-кристаллы, эндер-интерфейс и эндер-связку."]
	"quest.07CA1B7D2DF4365B.title": "Эндер-кристаллы"
	"quest.0D4EEE354365B0A4.quest_desc": ["Эндер-кирка и эндер-меч не ломаются и телепортируют блоки к себе. Архивариусы носили их с собой всю жизнь.", "Сделай эндер-кирку и эндер-топор."]
	"quest.0D4EEE354365B0A4.title": "Эндер-инструменты"
	"quest.0C3B286F91C32B2D.quest_desc": ["Обычный диск хранит 1К предметов, но если нужно больше, есть диски на 4К, 16К и даже на терабайт.", "Сделай диск на 4 тысячи предметов и диск на 16 тысяч."]
	"quest.0C3B286F91C32B2D.title": "Большие диски"
	"quest.075FC94970D760DA.quest_desc": ["В диск можно залить жидкость: вода, лава, дизельное топливо. Потом качать насосом прямо в трубы.", "Сделай диск для жидкости и для химии."]
	"quest.075FC94970D760DA.title": "Жидкостные диски"
	"quest.008161F72A9687D3.quest_desc": ["Ячейка хранит не предметы, а объёмы газа, жидкости или химии. Ячейка на 65 миллионов единиц заменяет целую бочку.", "Собери ячейку на 1024 и на 4096, а также большую ячейку на 65 миллионов."]
	"quest.008161F72A9687D3.title": "Большие ячейки"
	"quest.0171C3EF60CDE4B6.quest_desc": ["Крафтовое хранилище на 4096 и 65536 слотов помогает, когда рецептов больше, чем рук.", "Собери хранилище на 4096 и на 65536 слотов."]
	"quest.0171C3EF60CDE4B6.title": "Хранилище для крафта"
	"quest.0D061034F3002EB4.quest_desc": ["Беспроводной терминал работает без проводов — нужно только носить с собой карту или маячок.", "Собери универсальный беспроводной терминал и привязку."]
	"quest.0D061034F3002EB4.title": "Беспроводные терминалы"
	"quest.02B5BFA34615CF1F.quest_desc": ["Модули AE2: Lightning Tech увеличивают поток энергии. С ними сеть перестаёт задыхаться на больших объёмах.", "Собери модули первого, второго и третьего уровня."]
	"quest.02B5BFA34615CF1F.title": "Энергетические модули"
	"quest.0EE2E02BC3EBCC6A.quest_desc": ["Матрицы искажения материи позволяют хранить вещи, которые обычная сеть не примет: они живут в своём измерении.", "Собери матрицу хранения паттернов и терморегулятор."]
	"quest.0EE2E02BC3EBCC6A.title": "Искажение материи"
}
