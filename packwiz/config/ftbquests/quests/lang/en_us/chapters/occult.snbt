{
	"quest.08AFD2D9A1E0C171.quest_desc": ["Иесний — тёмный металл духов. Из него делают наковальни, ножи и всё, что не должно притягивать внимание.", "Найди руду иесния, выплавь слиток и купи наковальню вVillage."]
	"quest.08AFD2D9A1E0C171.title": "Иесний"
	"quest.08F3DD4BC588BFC2.quest_desc": ["Серебро удерживает духов и очищает расчёты. Из него делают чаши, слитки и зеркала.", "Добудь серебро и выплавь из него слитки — обычные и стерлинговые."]
	"quest.08F3DD4BC588BFC2.title": "Серебро"
	"quest.07D3B6955881B748.quest_desc": ["Каждая книга призывает своего духа: африта, джинна, фолиота, марида. Пустая книга — основа для любой.", "Сделай четыре книги призыва и одну пустую."]
	"quest.07D3B6955881B748.title": "Книги призыва"
	"quest.06F86DF2ECA9F8D2.quest_desc": ["Чаша принимает плату за призыв. Простая медная, золотая, тёмная и серебряная — у каждой свой нрав.", "Сделай четыре чаши: медную, золотую, серебряную и тёмную."]
	"quest.06F86DF2ECA9F8D2.title": "Жертвенные чаши"
	"quest.028705D29F99E827.quest_desc": ["Фамильяр — это дух, который живёт рядом и работает. Кольцо призывает его, сумка удерживает.", "Сделай кольцо фамильяра и ритуальную сумку первого уровня."]
	"quest.028705D29F99E827.title": "Фамильяры"
	"quest.0B36CC3192AB593E.quest_desc": ["Осколок души, самоцвет, хрупкий самоцвет и триединый камень — это лестница от небрежной работы к настоящей.", "Собери самоцвет души, его осколок и триединый камень."]
	"quest.0B36CC3192AB593E.title": "Самоцветы душ"
	"quest.0175A5E31B53C606.quest_desc": ["Каждый дух оставляет эссенцию: африт — жар, марьяд — вода, иной мир — тайна, жестокость — пустота.", "Собери все четыре эссенции."]
	"quest.0175A5E31B53C606.title": "Эссенции духов"
	"quest.08F6D337E5AC2338.quest_desc": ["Ритуальная сумка переносит жертвоприношения и защищает от чужих глаз. Чем выше уровень, тем меньше она выглядит снаружи.", "Сделай сумку второго уровня и эндер-сумку."]
	"quest.08F6D337E5AC2338.title": "Ритуальная сумка"
	"quest.074E6BC549C987E1.quest_desc": ["Контроллер хранилища держит предметы в измерении духов, а пульт даёт доступ к нему откуда угодно.", "Собери контроллер хранилища, пульт и стабилизатор второго уровня."]
	"quest.074E6BC549C987E1.title": "Хранилище духов"
	"quest.0ED2C46F2E918D38.quest_desc": ["Пентакль — это чертёж ритуала, разложенный на земле. Алтарь пентакля превращает схему в рабочую магию.", "Собери алтарь пентакля, схему и пустую схему."]
	"quest.0ED2C46F2E918D38.title": "Пентакль"
	"quest.036599EB072C6EC9.quest_desc": ["Механическая камера проводит ритуал без участия человека: туда кладут жертву и механизм, а на выходе — результат.", "Собери механическую камеру, механический измельчитель и улучшения для духов."]
	"quest.036599EB072C6EC9.title": "Механический ритуал"
	"quest.06FEF47955AA2780.quest_desc": ["Флогипорт переносит тепло туда, где оно нужно, минуя стены. Работает на флогистоне и растворе духов.", "Собери флогипорт, флогистон и серебряный флогистат."]
	"quest.06FEF47955AA2780.title": "Флогипорт"
	"quest.0D320DCF1685D13D.quest_desc": ["Иной мир — это другое измерение с другими деревьями. Очки гвардят от его влияния, зола показывает дорогу.", "Найди иной мир, собери очки и несколько образцов его дерева."]
	"quest.0D320DCF1685D13D.title": "Иной мир"
	"quest.04B4A6B373015CDE.quest_desc": ["Жезл гадания отвечает на вопросы, словарь духов рассказывает о них, а запретная книга — о том, что знать нельзя.", "Сделай жезл гадания, словарь духов и настольную книгу знаний."]
	"quest.04B4A6B373015CDE.title": "Гадание и знание"
	"quest.09BA5F1E1BA0A77B.quest_desc": ["Детектор показывает, где пролом в иной мир. Рядом с ним всегда есть что подобрать.", "Собери детектор иного мира."]
	"quest.09BA5F1E1BA0A77B.title": "Детектор иного мира"
}
