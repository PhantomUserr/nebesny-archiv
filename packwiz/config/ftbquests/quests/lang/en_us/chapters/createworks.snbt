{
	"quest.0949908196CA70EA.quest_desc": ["Медь и железо тянутся в проволоку, проволока наматывается на катушку. Так получается передача энергии без валов.", "Сделай катушку, медную и железную проволоку — из них потом соберутся моторы."]
	"quest.0949908196CA70EA.title": "Мотки и проволока"
	"quest.060FFE5BBEFE04E6.quest_desc": ["Латунные и медные стержни — заготовки для проволоки и прутков. Из них делают и катушки, и медные детали.", "Сделай латунный и медный стержни."]
	"quest.060FFE5BBEFE04E6.title": "Стержни"
	"quest.0DAEBD712825AD29.quest_desc": ["Электромотор крутится без трения и не требует обслуживания. Для него нужны магниты, проволока и красный провод.", "Собери электромотор — он станет сердцем любой электрической машины."]
	"quest.0DAEBD712825AD29.title": "Электрический мотор"
	"quest.022620F3B319B09E.quest_desc": ["Катушка Тесла превращает электричество в разряд. Поставь её рядом с устройством — и оно получит энергию.", "Собери катушку и проверь, что она бьёт по-настоящему."]
	"quest.022620F3B319B09E.title": "Катушка Тесла"
	"quest.06E983E062378553.quest_desc": ["Энергия в Архиве хранилась в аккумуляторах. Теперь та же идея: заряди батарею — и отдавай её дальше.", "Собери накопитель энергии и заряди его."]
	"quest.06E983E062378553.title": "Заряд энергии"
	"quest.04E2C2735D9D65B0.quest_desc": ["Из биомассы делают топливо для двигателей, а из топлива — почти всё остальное.", "Собери брикет биомассы и ведро биоэтанола."]
	"quest.04E2C2735D9D65B0.title": "Биомасса и топливо"
	"quest.0A9CB464A84D07B1.quest_desc": ["Шкурка с алмазной крошкой точит всё что угодно: и железо, и создание — любое. И тратится быстро.", "Сделай алмазную шкурку и держи её под рукой."]
	"quest.0A9CB464A84D07B1.title": "Алмазная шкурка"
	"quest.09949EC0E7C355FB.quest_desc": ["Торт на(Create: Additions) печётся в форме и требует теста. Из него выходят шоколадные и медвые варианты.", "Сделай основу для торта, а потом и сам шоколадный торт."]
	"quest.09949EC0E7C355FB.title": "Торты"
	"quest.06378F49B63352A8.quest_desc": ["Резервуар держит жидкость и выдаёт её по трубам. Обычная труба течёт по-разному — ёмкость работает ровно.", "Собери резервуар и поставь его под воду."]
	"quest.06378F49B63352A8.title": "Ёмкость для жидкости"
	"quest.0C4E804088C487FA.quest_desc": ["Панель показывает, что происходит в сети: заполнение резервуара, заряд батареи, обороты.", "Сделай панель и подключи её к резервуару."]
	"quest.0C4E804088C487FA.title": "Приборная панель"
	"quest.09773CCD15E2FE48.quest_desc": ["Копир делает сразу несколько деталей из одного образца. Это самый быстрый способ собрать стену или ряд валов.", "Собери копир и сделай с его помощью коробку и стену."]
	"quest.09773CCD15E2FE48.title": "Копирование"
	"quest.07742ED28C8B88AE.quest_desc": ["Ба��арея копит вращение и отдаёт его потом. Удобно, когда двигатель работает рывками.", "Собери батарею и заряди её."]
	"quest.07742ED28C8B88AE.title": "Кинетическая батарея"
	"quest.04BBB3A38FD2D40F.quest_desc": ["Коробка меняет направление и скорость вращения. Обычная меняет только скорость, параллельная — ещё и направление, а шестиступенчатая — и то и другое сразу.", "Собери вертикальную параллельную коробку и шестиступенчатую."]
	"quest.04BBB3A38FD2D40F.title": "Коробки передач"
	"quest.05CF27DBB6CDCD93.quest_desc": ["Предохранительные муфты и тормоза удерживают вал от перегрузки. Без них любой механизм рано или поздно сломается.", "Собери тормоз и предохранительную муфту."]
	"quest.05CF27DBB6CDCD93.title": "Тормоза и сцепления"
	"quest.0E1E28AD5C6D7467.quest_desc": ["Закрытый вал передаёт вращение внутри прочного корпуса и не пачкает всё вокруг. На корабле это обязательно.", "Собери закрытый вал из стекла и закрытую зубчатую передачу из андезита."]
	"quest.0E1E28AD5C6D7467.title": "Закрытые передачи"
	"quest.0B22FA18690011E9.quest_desc": ["Картонные блоки и окна из сплава — дешёвый способ сделать цех красивым, не тратясь на стекло.", "Сделай окно из андезитового сплава и два блока из картона."]
	"quest.0B22FA18690011E9.title": "Окна и картон"
	"quest.03D8DF0F25B2619F.quest_desc": ["Кошки, окна, листы и таблички делают фабрику похожей на фабрику, а не на свалку механизмов.", "Собери кошку, окно и табличку из андезита."]
	"quest.03D8DF0F25B2619F.title": "Цех, а не дыра"
	"quest.070D8B890C15A46B.quest_desc": ["Тяга вместо вращения: реактивный двигатель толкает конструкцию напрямую. На корабле это единственный способ разогнаться.", "Собери реактивный и векторный двигатели."]
	"quest.070D8B890C15A46B.title": "Реактивные двигатели"
	"quest.0344941ED46B8F52.quest_desc": ["Джойстик и тумблеры — это органы управления. Без них управлять кораблём нечем.", "Собери джойстик и аналоговый переключатель."]
	"quest.0344941ED46B8F52.title": "Джойстик и переключатель"
	"quest.0E0FCA005E9C95B9.quest_desc": ["Смола идёт в пропитку и приводные ремни, скипидар — в очистку и в составы. Запах резкий, польза реальная.", "Собери немного смолы и скипидара."]
	"quest.0E0FCA005E9C95B9.title": "Смола и скипидар"
	"quest.011ED94DC757F495.quest_desc": ["Усилитель хода удваивает скорость вала, а умный усилитель — ровно настолько, насколько надо.", "Собери обычный и умный усилители хода."]
	"quest.011ED94DC757F495.title": "Усилитель хода"
	"quest.0C9114C909F173A5.quest_desc": ["Форсунка впрыскивает топливо в двигатель. Без неё мотор запустится и сразу встанет.", "Собери форсунку и современный инжектор."]
	"quest.0C9114C909F173A5.title": "Форсунки"
	"quest.0915B43A0826B050.quest_desc": ["Загрузчик чанков держит область загруженной, даже когда рядом никого нет. Без него фабрика простаивает.", "Собери загрузчик из латуни или андезита."]
	"quest.0915B43A0826B050.title": "Загрузчик чанков"
	"quest.05F82117AAA67AFC.quest_desc": ["Create: Simulated Additions учит машину считать. Вычислитель решает задачи, а радиокомпьютер управляет целой сетью.", "Собери вычислитель и радиокомпьютер."]
	"quest.05F82117AAA67AFC.title": "Вычислитель и радиокомпьютер"
	"quest.0D26DE4C3ECE72EA.quest_desc": ["Радиопереключатель переводит стрелки по сигналу. Поезда на перегонах ходят по радио — без него никак.", "Собери радиопереключатель и включи его."]
	"quest.0D26DE4C3ECE72EA.title": "Переключатель пути"
}
