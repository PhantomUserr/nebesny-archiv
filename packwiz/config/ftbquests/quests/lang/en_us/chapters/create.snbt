{
	"quest.6FA27F1C93D4F606.quest_desc": ["Create начинается с андезитового сплава. Смешай андезит и железный самородок — точный рецепт смотри в JEI.", "Сделай хотя бы 8 сплавов."]
	"quest.6FA27F1C93D4F606.title": "Андезитовый сплав"
	"quest.114972F7C4A9A381.quest_desc": ["??? ???????? ????????. ??????? ??? ????? ??????? ? ??????????.", "???? ????? ?????????, ???????????? ? ????????? ?????????."]
	"quest.114972F7C4A9A381.title": "Валы"
	"quest.39A844570D771B91.quest_desc": ["Шестерни меняют направление и скорость вращения. Большая шестерня замедляет, маленькая ускоряет.", "Сделай несколько маленьких и одну большую."]
	"quest.39A844570D771B91.title": "Шестерни"
	"quest.D55895B2FC79188F.quest_desc": ["Водяное колесо — самый простой источник энергии. Поставь его в поток воды так, чтобы вода толкала лопасти.", "Подключи вал — и вращение пошло."]
	"quest.D55895B2FC79188F.title": "Водяное колесо"
	"quest.13F16CC570578CE0.quest_desc": ["Ветряное колесо даёт больше энергии, но требует парусов и открытого неба.", "Поставь подшипник, прикрепи паруса и наслаждайся бесплатным вращением."]
	"quest.13F16CC570578CE0.title": "Ветряк"
	"quest.30DCB97554A6D90E.quest_desc": ["Пресс сжимает предметы: листы, блоки, детали. Поставь его над депо или лентой.", "Ему нужно вращение сверху."]
	"quest.30DCB97554A6D90E.title": "Механический пресс"
	"quest.87901D704306B8A1.quest_desc": ["Миксер смешивает ингредиенты в чаше. Без него не сделать латунь и многие сплавы.", "Поставь чашу под миксер и подай вращение."]
	"quest.87901D704306B8A1.title": "Механический миксер"
	"quest.36202AD95D4358A7.quest_desc": ["Пила распиливает брёвна и предметы без потерь. Отличный способ автоматизировать доски."]
	"quest.36202AD95D4358A7.title": "Механическая пила"
	"quest.49A4E379B29762BF.quest_desc": ["Вентилятор обдувает предметы и мобов. С лавой он плавит, с водой — тушит, с огнём — готовит.", "Поставь его в корпус и подай вращение."]
	"quest.49A4E379B29762BF.title": "Вентилятор"
	"quest.4F8F7FC0D1681657.quest_desc": ["Жернов дробит руду и зёрна. Поставь его под вал и засыпай предметы сверху."]
	"quest.4F8F7FC0D1681657.title": "Жернов"
	"quest.CC984BDA2B468B24.quest_desc": ["Чаша нужна для смешивания, варки и прессования жидкостей. Ставь её под миксер или пресс."]
	"quest.CC984BDA2B468B24.title": "Чаша"
	"quest.0756073B85A651ED.quest_desc": ["Лента двигает предметы между машинами. Соедини две точки и подай вращение.", "Сделай 4 секции ленты."]
	"quest.0756073B85A651ED.title": "Конвейер"
	"quest.FAB380031A0D63C1.quest_desc": ["Воронки забирают и выдают предметы. Андезитовая — базовая, латунная — быстрее и умнее.", "Сделай обе: они понадобятся для автоматизации."]
	"quest.FAB380031A0D63C1.title": "Воронки"
	"quest.A1AF8F5EE5C6D01C.quest_desc": ["Латунь — сплав меди и цинка. Плавь её в чаше миксером или в плавильне.", "Латунные детали открывают продвинутые механизмы."]
	"quest.A1AF8F5EE5C6D01C.title": "Латунь"
	"quest.5E6EE1C4F9032440.quest_desc": ["Точный механизм — сердце сложных машин. Собери хотя бы один: он понадобится для поездов и аэронавтики."]
	"quest.5E6EE1C4F9032440.title": "Точный механизм"
	"quest.E0AC64A219AAD4F0.quest_desc": ["Регулятор меняет скорость вращения. Пригодится, когда механизмы работают слишком быстро или медленно."]
	"quest.E0AC64A219AAD4F0.title": "Регулятор скорости"
	"quest.CFA9D7191048FDF1.quest_desc": ["Крафтер собирает предметы по рецепту автоматически. Поставь его рядом с лентой и настрой рецепт."]
	"quest.CFA9D7191048FDF1.title": "Механический крафтер"
	"quest.64BCFFC7C87D8382.quest_desc": ["Create добавляет настоящие рельсы для поездов. Сделай 32 секции и проложи путь.", "Рельсы ставятся на землю и соединяются автоматически."]
	"quest.64BCFFC7C87D8382.title": "Рельсы"
	"quest.AA406E4BFDC87B1D.quest_desc": ["Станция собирает поезд и останавливает его. Поставь её в конце пути."]
	"quest.AA406E4BFDC87B1D.title": "Станция"
	"quest.8EE69FEEB63C9A02.quest_desc": ["Собери поезд из локомотива и вагонов, поставь его на рельсы и прокатись. Это проще, чем кажется: собери состав, сядь и нажми газ."]
	"quest.8EE69FEEB63C9A02.title": "Первая поездка"
	"quest.B990E6BC796B8496.quest_desc": ["Колесо качает воду, но без насоса она всё равно течёт мимо. Поставь механический насос рядом с водяным колесом — и фермы получат воду по трубам.", "Подключи насос валом к источнику вращения и направь трубы туда, где нужна вода."]
	"quest.B990E6BC796B8496.title": "Механический насос"
}
