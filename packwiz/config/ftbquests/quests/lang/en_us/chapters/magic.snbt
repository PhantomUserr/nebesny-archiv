{
	"quest.87BBA1E7C4F987FE.quest_desc": ["Ars Nouveau начинается с книги заклинаний. Скрафти её и открой — внутри дерево заклинаний.", "Заклинания собираются из глифов. Начни с простого: «Свет» или «Снаряд»."]
	"quest.87BBA1E7C4F987FE.title": "Книга новичка"
	"quest.2A79940E91D1BF82.quest_desc": ["Жезл — инструмент для создания заклинаний и ритуалов в Ars Nouveau.", "Сделай его вместе с книгой новичка: на жезле можно наносить глифы, из которых собираются заклинания."]
	"quest.2A79940E91D1BF82.title": "????"
	"quest.7E1FE8E0EBF40AE0.quest_desc": ["Source — мана Ars Nouveau. Банка источника собирает её из цветов и растений вокруг.", "Поставь банку рядом с садом."]
	"quest.7E1FE8E0EBF40AE0.title": "Источник магии"
	"quest.2DEF308668B69DB6.quest_desc": ["Имбуирование заряжает предметы магией. Поставь камеру и подай в неё source."]
	"quest.2DEF308668B69DB6.title": "Имбуирование"
	"quest.787325E0953E1C55.quest_desc": ["Enchanting Apparatus создаёт магические предметы и улучшения. Поставь его на пьедесталы."]
	"quest.787325E0953E1C55.title": "Чары"
	"quest.BF47B19C711FDD02.quest_desc": ["Жаровня запускает ритуалы. Положи в неё нужные предметы и подожги.", "Ритуалы умеют вызывать дождь, летать и многое другое."]
	"quest.BF47B19C711FDD02.title": "Ритуальная жаровня"
	"quest.62C252126931DE0B.quest_desc": ["Iron’s Spellbooks — вторая магическая школа. Скрафти железную книгу и открой её.", "Заклинания здесь изучаются через свитки и стол начертания."]
	"quest.62C252126931DE0B.title": "Книга заклинаний"
	"quest.6999FB97AAF9DC5A.quest_desc": ["На столе начертания ты создаёшь свитки заклинаний. Поставь его рядом с книгой."]
	"quest.6999FB97AAF9DC5A.title": "Стол начертания"
	"quest.7053DA085042999E.quest_desc": ["На арканной наковальне улучшают снаряжение и накладывают магические свойства."]
	"quest.7053DA085042999E.title": "Арканная наковальня"
	"quest.49C8CEA3AB150F80.quest_desc": ["Эссенция — топливо для магии Iron’s Spellbooks. Добывается с мобов и из руды.", "Собери 8 штук."]
	"quest.49C8CEA3AB150F80.title": "Арканная эссенция"
	"quest.CC3472B3AF2958AB.quest_desc": ["Malum — мрачная магия душ, и рунный верстак — её первый шаг.", "Поставь верстак рядом с домом или в мастерской и открой его, чтобы посмотреть рецепты первых рун."]
	"quest.CC3472B3AF2958AB.title": "?????? ???????"
	"quest.3DB3D5C95AED671D.quest_desc": ["Алтарь принимает подношения и создаёт духовные предметы. Поставь его и положи ингредиенты."]
	"quest.3DB3D5C95AED671D.title": "Алтарь духов"
	"quest.176ABE8D5143C058.quest_desc": ["Коса собирает души с убитых мобов. Сделай грубую косу и испытай её в бою."]
	"quest.176ABE8D5143C058.title": "Коса"
	"quest.F660D65109DEE229.quest_desc": ["Банка хранит души. Без неё души пропадают после смерти моба."]
	"quest.F660D65109DEE229.title": "Банка духов"
	"quest.8DAA256D111E987E.quest_desc": ["Soul Stained Steel — прочный магический металл. Сплавы делаются на алтаре."]
	"quest.8DAA256D111E987E.title": "Сталь душ"
	"quest.BD26CFD5683648B9.quest_desc": ["Goety — школа некромантии. Начни с тёмного жезла и книги."]
	"quest.BD26CFD5683648B9.title": "Тёмный жезл"
	"quest.31234A1B12295C27.quest_desc": ["Тёмный алтарь создаёт и усиливает посохи и фокусы. Поставь его в тени."]
	"quest.31234A1B12295C27.title": "Тёмный алтарь"
	"quest.F7367F8E895B1DE0.quest_desc": ["Spectrum — магия цвета. Палитра пигментов открывает первые рецепты."]
	"quest.F7367F8E895B1DE0.title": "Палитра пигментов"
	"quest.222F66BF8474764B.quest_desc": ["Fusion Shrine сплавляет материалы в магические сплавы. Поставь её на открытом месте."]
	"quest.222F66BF8474764B.title": "Кузня слияния"
	"quest.E956E2D733D08C57.quest_desc": ["Enchanter накладывает зачарования без стола. Он открывает доступ к сильным эффектам."]
	"quest.E956E2D733D08C57.title": "Зачарователь"
	"quest.94FA70507FCE3558.quest_desc": ["Theurgy — алхимия, которая разбирает вещества на первоэлементы. Начни с печи кальцинации.", "Это необязательная ветка, но она даёт редкие материалы."]
	"quest.94FA70507FCE3558.title": "Алхимия Теургии"
	"quest.73E40A96223605DF.quest_desc": ["Котёл сжижения плавит материалы в эссенции. Поставь его под открытым небом."]
	"quest.73E40A96223605DF.title": "Котёл сжижения"
	"quest.F05C2E6F3C5289F6.quest_desc": ["Эфир — светлое измерение над облаками. Собери рамку портала из светящегося камня и зажги её."]
	"quest.F05C2E6F3C5289F6.title": "Рамка портала в Эфир"
	"quest.626DFC8FBBD81345.quest_desc": ["Войди в портал и окажись в Эфире. Там свои руды, мобы и подземелья.", "Не забудь взять еду и оружие."]
	"quest.626DFC8FBBD81345.title": "Шаг в Эфир"
	"quest.676C35EBD45F8CBC.quest_desc": ["????? ?????? ????? ? ????: ?? ????? ??????? ?? ???????????. ????? ???????? ? ??? ??? ?? ?????? ??????, ? ????????? ??????????.", "?????? ?? ? ??????? ???? ????? ?????????? ? ?????????? ?????."]
	"quest.676C35EBD45F8CBC.title": "???????"
}
