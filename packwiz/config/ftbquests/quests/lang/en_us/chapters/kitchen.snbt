{
	"quest.048A8A2C18AFB725.quest_desc": ["Сковорода готовит быстро и на малом огне. Она заменяет вертел, жаровню и половину рецептов обычной кухни.", "Поставь сковороду на плиту или на лагерный костёр — и клади туда то, что жарится."]
	"quest.048A8A2C18AFB725.title": "Сковорода"
	"quest.018570A076083678.quest_desc": ["Нож режет мясо, овощи и сыр. От того, какой нож взять, зависит, что получится на разделочной доске.", "Сделай железный и каменный нож. Кременной — самый дешёвый, но режет грубо."]
	"quest.018570A076083678.title": "Ножи"
	"quest.033EEC7B1DE082BF.quest_desc": ["Тушу режут ножом по части: фарш, колбасы, котлеты. Ничего не выбрасывается, всё идёт в еду.", "Разделай корову: сделай фарш и котлеты."]
	"quest.033EEC7B1DE082BF.title": "Разделка туши"
	"quest.051E285D5F8CC533.quest_desc": ["Бекон — это свинина, нарезанная полосками. Жарится на сковороде мгновенно, а съедается всегда.", "Сделай два куска сырого бекона и один жареный."]
	"quest.051E285D5F8CC533.title": "Бекон"
	"quest.00E14876D7B4FAAB.quest_desc": ["Баранину режут на куски и жарят на сковороде. Из неё выходят и рагу, и пироги, и жареная баранина.", "Сделай два сырых куска и один жареный."]
	"quest.00E14876D7B4FAAB.title": "Куски баранины"
	"quest.0C2D6F03D809EA49.quest_desc": ["Курицу разделывают на кусочки — их жарят, кладут в суп и делают из них бутерброды.", "Сделай два сырых кусочка и один жареный."]
	"quest.0C2D6F03D809EA49.title": "Куриные кусочки"
	"quest.08D52C4948300637.quest_desc": ["Жареное яйцо — самая быстрая еда в Архиве. Оно восстанавливает голод мгновенно и не требует ни огня, ни кастрюли.", "Пожарь два яйца на сковороде."]
	"quest.08D52C4948300637.title": "Яйца на сковороде"
	"quest.05BACD02D6C12DA5.quest_desc": ["Сварить рис можно в кастрюле, а обжарить на сковороде — вкуснее и быстрее.", "Приготовь жареный рис и обычный варёный."]
	"quest.05BACD02D6C12DA5.title": "Рис на сковороде"
	"quest.0F7ADA18749857DA.quest_desc": ["Пирог начинается с теста. Раскатай основу, положи начинку и запеки — так выходит настоящий яблочный пирог.", "Сделай три основы для пирога: хватит на яблочный и на тыквенный."]
	"quest.0F7ADA18749857DA.title": "Основа для пирога"
	"quest.013244C43D702BA6.quest_desc": ["Яблочный пирог в Архиве считается праздничным блюдом. Его подавали на годовщину Нырка, когда флот ещё летал.", "Испеки пирог и положи на тарелку ломтик."]
	"quest.013244C43D702BA6.title": "Яблочный пирог"
	"quest.002EED4E24ADBC2B.quest_desc": ["Тыквенный пирог слаще яблочного и пахнет так, что весь корабль узнаёт о готовящемся ужине за квартал.", "Испеки пирог из тыквы. Тыкву можно вырастить самому — семена продаются в деревне."]
	"quest.002EED4E24ADBC2B.title": "Тыквенный пирог"
	"quest.081B419B4B670E13.quest_desc": ["Бульон — основа всех серьёзных супов. Его варят из костей, овощей и зелени, и варят долго.", "Свари бульон в кастрюле — дальше из него выйдет всё остальное."]
	"quest.081B419B4B670E13.title": "Костный бульон"
	"quest.0919F176DACBFE2B.quest_desc": ["В овощном супе должно быть видно, что он с огорода. Капуста, морковь, лук — и всё это в одной кастрюле.", "Свари суп из своих овощей."]
	"quest.0919F176DACBFE2B.title": "Овощной суп"
	"quest.07D426B685CFDB83.quest_desc": ["Тушёное мясо в бульоне — это то, чем кормили экипажи в долгих перелётах. Сытно, горячо и не портится.", "Приготовь рагу из говядины."]
	"quest.07D426B685CFDB83.title": "Мясо в кастрюле"
	"quest.077DBF22D2F22B8D.quest_desc": ["Луковый суп — это бульон, в котором лук жарили до золотистого цвета. Готовится долго, но стоит того.", "Свари луковый суп и не жалей лука."]
	"quest.077DBF22D2F22B8D.title": "Луковый суп"
	"quest.089DD6AFE9CFFC6F.quest_desc": ["Паста из теста — это лапша. Из неё выходят и суп, и паста с соусом, и всё, что нужно для горячего обеда.", "Свари лапша-суп."]
	"quest.089DD6AFE9CFFC6F.title": "Лапша"
	"quest.0337840BFFF05BFC.quest_desc": ["Настоящая паста готовится из муки и яиц, и подаётся с соусом. В Архиве её ели по субботам.", "Сделай сырую пасту и заправь её чернилами каракатиц — так готовили даже в пустоте."]
	"quest.0337840BFFF05BFC.title": "Паста"
	"quest.08C15BE533C180A4.quest_desc": ["Салат — это способ съесть всё, что наросло, и не подавиться. Смешанный салат собирают из овощей, а сияющий — из редких.", "Собери смешанный салат и сиящий."]
	"quest.08C15BE533C180A4.title": "Салаты"
	"quest.0D3AA30CC3F74CD5.quest_desc": ["Бутерброд — это быстрый обед на ходу. Хлеб, начинка, и еда готова. Их брали с собой в разведку.", "Сделай три вида бутербродов: с беконом, с яйцом и с курицей."]
	"quest.0D3AA30CC3F74CD5.title": "Бутерброды"
	"quest.0DDAA1E8A3E8F1E6.quest_desc": ["Хлеб — это тесто, разделённое на три части и выпеченное. Он не портится, его можно взять с собой и есть неделю.", "Испеки восемь хлебов: столько нужно флоту на переход."]
	"quest.0DDAA1E8A3E8F1E6.title": "Хлеб"
	"quest.06FE07F851C241C8.quest_desc": ["Яблочный сок в Архиве был валютой: им платили за перевозку и наливали в кастрюли вместо воды.", "Сделай две бутылки яблочного сока."]
	"quest.06FE07F851C241C8.title": "Яблочный сок"
	"quest.0E08B8C6932F978D.quest_desc": ["Печенье, кексы и чизкейк — то, что на Архиве готовили к праздникам. С ними любой перелёт проходит легче.", "Испеки печенье и чизкейк из ягод."]
	"quest.0E08B8C6932F978D.title": "Сладкое"
	"quest.0A1276BE4CF03802.quest_desc": ["Фаршированная тыква, картошка и капустные Rolls — это способ не выбрасывать ни одного овоща.", "Нафаршируй тыкву, картошку и сверни капустные рулетики с начинкой."]
	"quest.0A1276BE4CF03802.title": "Фаршированные овощи"
	"quest.0D26202E16225D2B.quest_desc": ["Перед взлётом флот кормят. Это не праздник, это порядок: человек, который сыт, летает ровно.", "Веста сказала: «Без стола не взлетаем». Собери стол: жареная курица, бургер, паста с фрикадельками и мясо с картошкой."]
	"quest.0D26202E16225D2B.title": "Пир флота"
}
