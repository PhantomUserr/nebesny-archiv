{
	"quest.07BE83E155D67062.quest_desc": ["Аэронавтика требует платину. Ищи руду в глубоких пещерах или перерабатывай породу.", "Собери 8 единиц сырья."]
	"quest.07BE83E155D67062.title": "Платина"
	"quest.0B0CA6DDA0DA06FA.quest_desc": ["Переплавь сырьё в слитки. Платина идёт на корпуса, двигатели и прочные детали."]
	"quest.0B0CA6DDA0DA06FA.title": "Платиновые слитки"
	"quest.08E943B3B705562A.quest_desc": ["Крылья создают подъёмную силу. Чем больше крыльев, тем тяжелее корабль можно поднять.", "Сделай хотя бы два крыла."]
	"quest.08E943B3B705562A.title": "Крылья"
	"quest.09BCE2F3F797C301.quest_desc": ["Самый простой двигатель. Кладёшь топливо, подаёшь красный сигнал — и корабль летит.", "Хорош для первого корабля, но топливо быстро кончается."]
	"quest.09BCE2F3F797C301.title": "Твердотопливный двигатель"
	"quest.0C7D8DB010D9163D.quest_desc": ["Жидкостный двигатель работает на топливе из бака. Он мощнее и экономичнее твердотопливного.", "Поставь бак рядом и подключи трубу."]
	"quest.0C7D8DB010D9163D.title": "Жидкостный двигатель"
	"quest.0EAB760A1987CC09.quest_desc": ["Векторный двигатель можно поворачивать — он меняет направление тяги. С ним корабль слушается руля.", "Поставь его на корму."]
	"quest.0EAB760A1987CC09.title": "Векторный двигатель"
	"quest.049A58BC10BD116C.quest_desc": ["Адаптер наклоняет двигатель или крыло. Помогает управлять кораблём и держать курс."]
	"quest.049A58BC10BD116C.title": "Наклонный адаптер"
	"quest.08A84F7CDDD6F9B9.quest_desc": ["Auto Glue склеивает блоки в единую конструкцию. Без него корабль развалится на части.", "Нанеси клей на блоки и собери корпус."]
	"quest.08A84F7CDDD6F9B9.title": "Клей для конструкции"
	"quest.0BA34900E37BC71C.quest_desc": ["Палка помогает двигать и поворачивать блоки конструкции. Также ей можно настроить сборку."]
	"quest.0BA34900E37BC71C.title": "Монтажная палка"
	"quest.02EA41D699EA1B25.quest_desc": ["Control Desk — главный пульт корабля. С него задаётся тяга и направление.", "Поставь его в кабине."]
	"quest.02EA41D699EA1B25.title": "Пульт управления"
	"quest.0D07F474A70CFA5E.quest_desc": ["Джойстик даёт плавное управление. Подключи его к пульту и двигателям."]
	"quest.0D07F474A70CFA5E.title": "Джойстик"
	"quest.0293178B6F16D8B6.quest_desc": ["Гироскоп стабилизирует корабль. С ним проще держать горизонт и не кувыркаться в воздухе."]
	"quest.0293178B6F16D8B6.title": "Гироскоп"
	"quest.0CEBAF0C396DD022.quest_desc": ["Балласт помогает центровать корабль. Если нос клюёт вниз — добавь балласт.", "Сделай 4 блока балласта."]
	"quest.0CEBAF0C396DD022.title": "Балласт"
	"quest.00B72EE4A4210CBC.quest_desc": ["Собери корпус, поставь крылья, двигатель, пульт и балласт. Склей всё в одну конструкцию и проверь, что она держится.", "Не спеши: лучше маленький корабль, который летает, чем огромный, который падает."]
	"quest.00B72EE4A4210CBC.title": "Собери корабль"
	"quest.0A97E8E373C21F59.quest_desc": ["Собери корабль до конца: крылья, двигатель, пульт и балласт. Хороший маленький корабль, который летает, лучше огромного, который падает.", "Поднимись в воздух и пролети хотя бы 100 блоков от старта. Управляй плавно — резкие повороты переворачивают корабль. Если корабль падает, проверь баланс, тягу и клей."]
	"quest.0A97E8E373C21F59.title": "Первый полёт"
	"quest.0B8DB98D61E10E7E.quest_desc": ["Блок заявки защищает твой корабль от чужих рук.", "Поставь его на борт корабля — после этого другие игроки не смогут ломать твой корабль без твоего разрешения."]
	"quest.0B8DB98D61E10E7E.title": "Застолбить небо"
	"quest.0DF8EE7CCEE22080.quest_desc": ["Из рельсов и вагонетки можно собрать настоящие горки. Поставь вагонетку на рельсы и запусти."]
	"quest.0DF8EE7CCEE22080.title": "Американские горки"
	"quest.023B8FBD8E7AC3EB.quest_desc": ["Один корабль — один пилот, а Архив большой. Подготовь запас крыльев для второго корабля или ремонта.", "Ангар — стартовая площадка, где новый корабль будет собираться и ждать своего часа."]
	"quest.023B8FBD8E7AC3EB.title": "Крылатый ангар"
}
