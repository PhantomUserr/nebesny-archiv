{
	"quest.0472AA96AC7A536F.quest_desc": ["Камень источника — живая порода, из которой Арс Нуво делает блоки. Трескается, но держит магию.", "Собери потрескавшийся камень источника и цепи из него."]
	"quest.0472AA96AC7A536F.title": "Камень источника"
	"quest.00F1609440E1F4C8.quest_desc": ["Магический свет — это мягкий синий огонь, который не гаснет. Архивариусы ставили такие фонари в коридорах.", "Собери обычный, усиленный и золотой фонарь магии."]
	"quest.00F1609440E1F4C8.title": "Фонари магии"
	"quest.0A0F876423A9923F.quest_desc": ["Оберег — это малое заклинание на цепочке. Огонь, вода, темнота, усталость — всё это можно отвести от себя.", "Сделай четыре оберега: от огня, от темноты, от воды и от усталости."]
	"quest.0A0F876423A9923F.title": "Обереги"
	"quest.096DD3DB7C9DD1F6.quest_desc": ["Золотой талисман и цепи — то, что носили на шее. Цепь из камня источника тянет сильнее золотой.", "Собери золотой талисман, золотую цепь и цепь из камня источника."]
	"quest.096DD3DB7C9DD1F6.title": "Талисманы и цепи"
	"quest.0ACF2AA5526C424F.quest_desc": ["Кодекс хранит выученные заклинания, древний кодекс — те, что забыли все. Потерянная запись — находка для Архива.", "Найди записи кодекса, древнюю и потерянную, а также зачарованный свиток."]
	"quest.0ACF2AA5526C424F.title": "Кодекс и свитки"
	"quest.0B86B221F6F9F610.quest_desc": ["Варп-указатель — это закладка в пространстве. Стабилизированный указатель ведёт надёжно, а навигатор-указатель — прямо к цели.", "Собери варп-индекс, стабилизированный варп-индекс и навигатор."]
	"quest.0B86B221F6F9F610.title": "Варп-указатели"
	"quest.0D18A5EF32595D74.quest_desc": ["Котёл ведьмы варит опыт в кувшине — самый честный способ набрать силы. Или превратить их в яблоки.", "Собери котёл ведьмы и кувшин опыта."]
	"quest.0D18A5EF32595D74.title": "Котёл ведьмы"
	"quest.0801270E9CCBAE21.quest_desc": ["Сумка на все случаи — это сундук, который всегда с тобой. А кристалл памяти хранит то, что ты не хочешь забыть.", "Собери сумку на все случаи и кристалл памяти."]
	"quest.0801270E9CCBAE21.title": "Сумка на все случаи"
	"quest.0FDE8A21B1FAE69D.quest_desc": ["Реликварий хранит реликвии, а ритуалы загружают чанки и находят структуры — магия, которая работает как карта.", "Собери нестабильный реликварий и два ритуальных свитка."]
	"quest.0FDE8A21B1FAE69D.title": "Реликварий"
	"quest.0AB2A2A4CDB205C5.quest_desc": ["Нексус — это постоянный портал. Свиток исследователя и свиток нексуса позволяют вернуться к нему издалека.", "Собери нексус и два свитка возврата."]
	"quest.0AB2A2A4CDB205C5.title": "Нексус"
}
