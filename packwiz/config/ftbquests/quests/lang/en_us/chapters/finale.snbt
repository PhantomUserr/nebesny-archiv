{
	"quest.477295F5E9A1E24C.quest_desc": ["Собери незеритовый слиток: древние обломки плавятся в печи и соединяются с золотом.", "Незерит — лучший ванильный материал."]
	"quest.477295F5E9A1E24C.title": "Незерит"
	"quest.4D294D08ED6BBDB5.quest_desc": ["Маяк даёт мощные эффекты всем рядом. Поставь его на пирамиду из железа или незерита."]
	"quest.4D294D08ED6BBDB5.title": "Маяк"
	"quest.F04E328B38E57625.quest_desc": ["Звезда выпадает с Иссушителя. Она нужна для маяка и многих сильных рецептов."]
	"quest.F04E328B38E57625.title": "Звезда Нижнего мира"
	"quest.0151C0A5EE49F38E.quest_desc": ["Элитры позволяют летать. Найди корабль Края и забери крылья."]
	"quest.0151C0A5EE49F38E.title": "Элитры"
	"quest.865A7AD21F4A7582.quest_desc": ["Построй музей: витрины с редкими предметами, трофеями боссов и магическими артефактами.", "Это место силы твоей базы и памяти о приключениях."]
	"quest.865A7AD21F4A7582.title": "Музей Архива"
	"quest.3A4E2E4089BB241E.quest_desc": ["Собери хотя бы три летающих корабля: грузовой, боевой и исследовательский.", "Архив снова должен подняться в небо."]
	"quest.3A4E2E4089BB241E.title": "Флот в небе"
	"quest.F5778D9C11F05143.quest_desc": ["Соедини технологии и магию: автоматизируй алтари, подключи магические машины к AE2, поставь на корабль магический реактор.", "Это необязательный мост между ветками, но именно он делает базу легендарной."]
	"quest.F5778D9C11F05143.title": "Техномагия"
	"quest.FA4E757F2B83F198.quest_desc": ["Собери 32 книжные полки и заполни ими библиотеку. Знания Архива должны быть в порядке.", "Можно использовать модовые полки — главное, чтобы книг было много."]
	"quest.FA4E757F2B83F198.title": "Хранилище знаний"
	"quest.A8AAD3B279D0BF31.quest_desc": ["Накопи 4 блока алмазов. Это не обязательно для финала, но приятно."]
	"quest.A8AAD3B279D0BF31.title": "Настоящий архимаг"
	"quest.B6526CB678FDB289.quest_desc": ["Победи всех сюжетных боссов: Нижнего монстра, Стража Края, Визиря и Цветок пустоты.", "Трофеи можно расставить в музее."]
	"quest.B6526CB678FDB289.title": "Коллекционер трофеев"
	"quest.E8D59F1B93F31AF9.quest_desc": ["Ты собрал знания, поднял флот и собрал команду. Архив снова в небе — теперь твоя очередь хранить его историю.", "Спасибо за игру. Дальше — только твои собственные цели: мегабазы, города, войны и новые миры."]
	"quest.E8D59F1B93F31AF9.title": "Архив снова в небе"
	"quest.60559198D4384125.quest_desc": ["Библиотека собрана: полки, книги, трофеи. Осталось запечатать память Архива.", "Собери три книги знаний — они станут символом восстановленных страниц и завершат коллекцию музея."]
	"quest.60559198D4384125.title": "Артефакт Архива"
}
