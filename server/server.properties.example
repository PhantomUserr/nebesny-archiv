# Nebesny Archiv - recommended server.properties
# Rename to server.properties on first launch (the server creates a default one otherwise).
# After editing, restart the server.

motd=\u00A76Nebesny Archiv \u00A78| \u00A7f\u0442\u0435\u0445\u043d\u043E\u043C\u0430\u0433\u0438\u044F \u0438 \u043D\u0435\u0431\u0435\u0441\u043D\u044B\u0435 \u043A\u043E\u0440\u0430\u0431\u043B\u0438
server-port=25565
max-players=6
online-mode=true
allow-flight=true
enable-command-block=true
spawn-protection=0
view-distance=8
simulation-distance=6
sync-chunk-writes=false
network-compression-threshold=256
prevent-proxy-connections=false
pause-when-empty-seconds=0
max-tick-time=180000
enforce-secure-profile=true
white-list=false
enable-status=true
